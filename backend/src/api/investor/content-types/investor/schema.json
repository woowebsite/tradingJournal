    "date": { "type": "date" },
    "sourceDate": { "type": "string" },
    "buyVolume": { "type": "integer" },
    "sellVolume": { "type": "integer" },
    "buyPercent": { "type": "decimal" },
    "sellPercent": { "type": "decimal" },
    "netBuy": { "type": "integer" },
    "marketNetBuy": { "type": "integer" },
    "netWeight": { "type": "integer" },
    "netShort": { "type": "integer" },
    "netBuyAmount": { "type": "integer" },
    "symbol": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::symbol.symbol",
      "inversedBy": "investors"
    }
  }
