{
  "kind": "collectionType",
  "collectionName": "symbols",
  "info": {
    "singularName": "symbol",
    "pluralName": "symbols",
    "displayName": "Symbol"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "Name": {
      "type": "string",
      "unique": true
    },
    "Description": {
      "type": "string"
    },
    "trades": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::trade.trade",
      "mappedBy": "symbol"
    },
    "market": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::market.market",
      "inversedBy": "symbols"
    },
    "symbol_histories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::symbol-history.symbol-history",
      "mappedBy": "symbol"
    },
    "signals": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::signal.signal",
      "mappedBy": "symbol"
    },
    "watch_lists": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::watch-list.watch-list",
      "inversedBy": "symbols"
    },
    "exchange": {
      "type": "string"
    },
    "shortName": { "type": "string" },
    "industryID": { "type": "integer" },
    "industryIDv2": { "type": "string" },
    "industryIdLevel2": { "type": "string" },
    "industryIdLevel4": { "type": "string" },
    "industry": { "type": "string" },
    "industryEn": { "type": "string" },
    "establishedYear": { "type": "string" },
    "noEmployees": { "type": "integer" },
    "noShareholders": { "type": "integer" },
    "foreignPercent": { "type": "decimal" },
    "website": { "type": "string" },
    "stockRating": { "type": "decimal" },
    "deltaInWeek": { "type": "decimal" },
    "deltaInMonth": { "type": "decimal" },
    "deltaInYear": { "type": "decimal" },
    "outstandingShare": { "type": "decimal" },
    "issueShare": { "type": "decimal" },
    "companyType": { "type": "string" },
    "ticker": { "type": "string" },
    "stockRatio": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::stock-ratio.stock-ratio",
      "mappedBy": "symbol"
    },
    "technicalAnalysis": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::symbol-technical-analysis.symbol-technical-analysis",
      "mappedBy": "symbol"
    },
    "sector": {
      "type": "string"
    },
    "chart_url": {
      "type": "string"
    }
  }
}
