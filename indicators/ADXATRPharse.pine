//@version=5
indicator("ADX+ATR 4-Phase (manual ADX) - v3", overlay=false)

// === INPUTS ===
adxLen      = input.int(14, "ADX Length")
adxMaLen    = input.int(20, "ADX MA Length (for momentum filter)")
atrLen      = adxLen //input.int(14, "ATR Length")
atrMaLen    = adxMaLen //input.int(20, "ATR MA Length")
adxBreak    = input.int(25, "ADX breakout threshold")
adxExhaust  = input.int(50, "ADX exhaustion threshold")
atrMult     = input.float(1.0, "ATR > MA(ATR) multiplier", step=0.05)
minConsec   = input.int(2, "Min consecutive bars for breakout confirmation", minval=1)

// === MANUAL ADX CALC (Wilder) ===
tr = math.max(high - low, math.max(math.abs(high - close[1]), math.abs(low - close[1])))
upMove = high - high[1]
downMove = low[1] - low
plusDM = (upMove > downMove and upMove > 0) ? upMove : 0.0
minusDM = (downMove > upMove and downMove > 0) ? downMove : 0.0

rTR = ta.rma(tr, adxLen)
rPlus = ta.rma(plusDM, adxLen)
rMinus = ta.rma(minusDM, adxLen)

plusDI = rTR == 0 ? 0.0 : 100 * (rPlus / rTR)
minusDI = rTR == 0 ? 0.0 : 100 * (rMinus / rTR)

dx = (plusDI + minusDI) == 0 ? 0.0 : 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
adxVal = ta.rma(dx, adxLen)

// === ATR ===
atrVal = ta.atr(atrLen)
atrMA = ta.sma(atrVal, atrMaLen)
adxMA = ta.sma(adxVal, adxMaLen)
adxMASmall = ta.sma(adxVal, adxMaLen / 2)

// === LOGIC ===
adxRising = adxVal >= adxMA  //  adxVal[1]
adxRisingConfirm = true// adxMA[adxMaLen / 2] < adxBreak
adxFalling = adxVal < adxMA //  adxVal[1]
atrAboveMA = atrVal > atrMA * atrMult
atrBelowMA = atrVal < atrMA

// breakout confirmation
breakCondRaw = (adxVal > adxBreak or adxRising) and atrAboveMA 
var bool breakCond = false
if minConsec == 1
    breakCond := breakCondRaw
else
    cnt = 0
    for i = 0 to minConsec - 1
        cnt += (breakCondRaw[i] ? 1 : 0)
    breakCond := cnt == minConsec

trendCond = adxVal >= adxBreak and (atrAboveMA or adxRising)                                       // green 
exhaustCond = adxVal >= adxBreak and adxFalling and adxVal < adxMASmall and adxVal[1] > adxBreak            // blue
compressionCond = (adxVal < adxBreak) and (atrVal < atrMA) and (adxVal < adxMA)     // red

phase = 0
phase := exhaustCond ? 4 : (trendCond ? 3 : (breakCondRaw ? 2 : (compressionCond ? 1 : 0)))

// === COLORS ===
// Tạo màu có độ trong suốt sẵn bằng color.new()
colCompression = color.new(color.maroon, 0)
colBreakout     = color.new(color.yellow, 40)
colTrending     = color.new(color.green, 0)
colExhaustion   = color.new(color.blue, 40)
colNeutral      = color.new(color.gray, 20)

phaseLabel = phase == 4 ? "Exhaustion" : phase == 3 ? "Trending" : phase == 2 ? "Breakout" : phase == 1 ? "Compression" : "Neutral"
phaseColor = phase == 4 ? colExhaustion : phase == 3 ? colTrending : phase == 2 ? colBreakout : phase == 1 ? colCompression : colNeutral

var color prevPhaseColor = na
phaseColor := phaseColor == colNeutral and not na(prevPhaseColor) ? prevPhaseColor : phaseColor
prevPhaseColor := phaseColor

// === VISUALS ===
// DÙNG color.new() THAY CHO `transp`
bgcolor(phaseColor, title="Phase Background")

plot(adxVal, color=color.yellow, title="ADX")
plot(adxMA, color=color.white, title="ADX_MA")
// plot(adxMASmall, color=color.blue, title="ADX_MA")
plot(plusDI, color=color.green, title="DI+", display=display.none)
plot(minusDI, color=color.red, title="DI-", display=display.none)

scaleFac = ta.sma(adxVal, 50) / (ta.sma(atrVal, 50) + 1e-9)
plot(atrVal * scaleFac, color=color.purple, title="ATR (scaled)")
plot(atrMA * scaleFac, color=color.gray, title="ATR_MA (scaled)")

plot(float(phase), title="Phase (numeric)", color=color.new(color.white, 80), style=plot.style_columns, linewidth=2)
hline(adxBreak, "ADX Break Threshold", color=color.new(color.gray, 0), linestyle=hline.style_dashed, linewidth=1)


var table t = table.new(position.top_right, 1, 6, bgcolor=color.new(color.black, 30), border_color=color.new(color.gray, 60), border_width=1, frame_color=color.new(color.gray, 40), frame_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Phase: " + phaseLabel + "\nADX: " + str.tostring(adxVal, format.mintick) + "  ATR: " + str.tostring(atrVal, format.mintick), text_color=color.white, bgcolor=phaseColor, text_size=size.small)
    table.cell(t, 0, 1, "Trending" + (phase == 3 ? " ◀" : ""), bgcolor=colTrending, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 2, "Breakout" + (phase == 2 ? " ◀" : ""), bgcolor=colBreakout, text_color=color.black, text_size=size.small)
    table.cell(t, 0, 3, "Compression" + (phase == 1 ? " ◀" : ""), bgcolor=colCompression, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 4, "Exhaustion" + (phase == 4 ? " ◀" : ""), bgcolor=colExhaustion, text_color=color.white, text_size=size.small)
    table.cell(t, 0, 5, "Neutral" + (phase == 0 ? " ◀" : ""), bgcolor=colNeutral, text_color=color.white, text_size=size.small)
