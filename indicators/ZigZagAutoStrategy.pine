//@version=6
strategy(
    title                   = "Zig Zag Auto Strategy",
    shorttitle              = "ZigZag Strategy",
    overlay                 = true,
    initial_capital         = 10000,
    default_qty_type        = strategy.percent_of_equity,
    default_qty_value       = 95,
    margin_long             = 0,
    margin_short            = 0,
    commission_type         = strategy.commission.percent,
    commission_value        = 0.05,
    process_orders_on_close = true,
    max_lines_count         = 500,
    max_labels_count        = 500,
    max_boxes_count         = 500
)

import TradingView/ZigZag/9 as ZigZagLib 

// Cấu trúc lưu trữ FVG chưa bị quét (Unmitigated FVG)
type ActiveFvg
    box   bx
    float top
    float btm
    bool  isBull
    int   startBar
// Tooltips
string TT_D = (
	"Specifies the total number of bars required to confirm a pivot point. "
	+ "The required number of left and right bars is half this value, rounded down as necessary."
)

// Inputs
bool   useAtr         = input.bool(true, "Use ATR for Deviation", group = "Deviation Settings")
int    atrLength      = input.int(14, "ATR Length", minval = 1, group = "Deviation Settings")
float  atrMult        = input.float(1.5, "ATR Multiplier", minval = 0.1, step = 0.1, tooltip = "Multiplier applied to ATR to determine reversal deviation (%)", group = "Deviation Settings")
float  fixedDev       = input.float(5.0, "Fixed Deviation (%)", minval = 0.00001, maxval = 100.0, step = 0.5, group = "Deviation Settings")
int    depthInput     = input.int(5, "Pivot legs", 2, tooltip = TT_D)
color  lineColorUp    = input(#00BCD4, "Line color Up", display = display.none)
color  lineColorDown  = input(#F23645, "Line color Down", display = display.none)
bool   showChgInput   = input.bool(true, "Price difference", inline = "priceRev")
string priceDiffInput = input.string("Percent", "", ["Absolute", "Percent"], inline = "priceRev", display = display.none, active = showChgInput)

// Volume Profile Inputs
bool   showVpInput    = input.bool(false, "Show Volume Profile (Last 4 waves)", group = "Volume Profile Settings")
int    vpWavesInput   = input.int(4, "Number of Waves", minval = 1, maxval = 10, group = "Volume Profile Settings")
int    vpRowsInput    = input.int(12, "Number of Rows/Bins", minval = 4, maxval = 30, group = "Volume Profile Settings")
bool   showPocInput   = input.bool(true, "Highlight POC (Point of Control)", group = "Volume Profile Settings")
color  vpUpColor      = input.color(color.new(#00BCD4, 65), "VP Up Wave Color", group = "Volume Profile Settings")
color  vpDownColor    = input.color(color.new(#F23645, 65), "VP Down Wave Color", group = "Volume Profile Settings")
color  vpPocColor     = input.color(color.new(#FFEB3B, 20), "POC Color", group = "Volume Profile Settings")

// Fair Value Gap (FVG) Inputs
bool   showFvgInput      = input.bool(true, "Show Fair Value Gap", group = "Fair Value Gap (FVG) Settings")
bool   hideMitigatedFvg  = input.bool(true, "Hide Mitigated FVGs", tooltip = "Tự động xóa các FVG khi có nến đóng cửa vượt qua vùng FVG (Bullish: close < bottom, Bearish: close > top)", group = "Fair Value Gap (FVG) Settings")
float  fvgMinSize        = input.float(0.0, "Min FVG Gap Size (%)", minval = 0.0, step = 0.05, group = "Fair Value Gap (FVG) Settings")
color  fvgBullColor      = input.color(color.new(#00BCD4, 75), "Bullish FVG Color", group = "Fair Value Gap (FVG) Settings")
color  fvgBearColor      = input.color(color.new(#F23645, 75), "Bearish FVG Color", group = "Fair Value Gap (FVG) Settings")
color  fvgBorderBull     = input.color(color.new(#00BCD4, 35), "Bullish Border", group = "Fair Value Gap (FVG) Settings")
color  fvgBorderBear     = input.color(color.new(#F23645, 35), "Bearish Border", group = "Fair Value Gap (FVG) Settings")

// Signal Settings
bool   showLongSignals  = input.bool(true, "Show Long Signal", group = "Signal Settings")
bool   showShortSignals = input.bool(true, "Show Short Signal", group = "Signal Settings")
float  rrrInput         = input.float(2.0, "Risk:Reward Ratio (RRR)", minval = 0.1, step = 0.5, tooltip = "Hệ số RRR tính theo khoảng cách Stoploss", group = "Signal Settings")
bool   partialTpInput   = input.bool(true, "Take 50% TP at Strong Wave Peak/Trough", tooltip = "Chốt lời 50% khối lượng tại đỉnh/đáy của sóng mạnh trước đó (lineWidth = 2), 50% còn lại chốt theo RRR", group = "Signal Settings")
bool   showTpSlLines    = input.bool(true, "Show TP/SL Target Lines", group = "Signal Settings")

// Calculate dynamic deviation from ATR(14) as percentage of close price
float  atrVal         = ta.atr(atrLength)
float  atrDevPercent  = (atrVal / close) * 100 * atrMult
float  deviationInput = useAtr ? atrDevPercent : fixedDev

// Create a `ZigZag` object from user settings.
var zigZag = ZigZagLib.newInstance(
    ZigZagLib.Settings.new(
        deviationInput, depthInput, lineColorUp, true, 
		true, true, true, priceDiffInput, true
	)
)

// Update deviation dynamically on each bar
zigZag.settings.devThreshold := deviationInput

// Update the Zig Zag on each bar, adding new pivot points and drawings when possible.
zigZag.update()

// Update line colors và line widths:
// - Chỉ duyệt tối đa 4 pivot gần nhất trên mỗi bar để tối ưu hiệu năng
int pSize = array.size(zigZag.pivots)
if pSize > 0
    int startIdx = math.max(0, pSize - 4)
    for i = startIdx to pSize - 1
        ZigZagLib.Pivot p = array.get(zigZag.pivots, i)
        if not na(p.ln)
            // Màu sắc theo chiều sóng
            line.set_color(p.ln, p.isHigh ? lineColorUp : lineColorDown)
            
            // Độ dày nét vẽ theo volume
            int lineWidth = 1
            if i >= 2
                ZigZagLib.Pivot prevSame = array.get(zigZag.pivots, i - 2)
                if not na(p.vol) and not na(prevSame.vol) and p.vol > prevSame.vol
                    lineWidth := 2
            line.set_width(p.ln, lineWidth)


// Quản lý FVG chưa bị quét (Unmitigated FVG - Tự động xóa khi giá đóng cửa qua FVG)
var array<ActiveFvg> activeFvgs = array.new<ActiveFvg>()

if showFvgInput and bar_index >= 2
    // 1. Kiểm tra xem các FVG hiện có đã bị giá đóng cửa vượt qua hay chưa (nếu bật hideMitigatedFvg)
    if array.size(activeFvgs) > 0
        for i = array.size(activeFvgs) - 1 to 0
            ActiveFvg item = array.get(activeFvgs, i)
            // Chỉ kiểm tra các nến sau nến hình thành FVG
            if bar_index > item.startBar
                bool isSwept = false
                if hideMitigatedFvg
                    if item.isBull
                        // Bullish FVG bị ẩn khi giá đóng cửa nằm dưới đáy FVG (close < item.btm)
                        if close < item.btm
                            isSwept := true
                    else
                        // Bearish FVG bị ẩn khi giá đóng cửa nằm trên đỉnh FVG (close > item.top)
                        if close > item.top
                            isSwept := true
                
                if isSwept
                    box.delete(item.bx)
                    array.remove(activeFvgs, i)
    
    // 2. Phát hiện FVG mới và tạo hộp FVG với width cố định như ban đầu (depthInput * 3)
    // Bullish FVG: Low nến 3 > High nến 1
    if low > high[2]
        float fvgTop = low
        float fvgBtm = high[2]
        float fvgGap = ((fvgTop - fvgBtm) / fvgBtm) * 100
        if fvgGap >= fvgMinSize
            box bx = box.new(
                left         = bar_index - 1,
                top          = fvgTop,
                right        = bar_index + depthInput * 3,
                bottom       = fvgBtm,
                xloc         = xloc.bar_index,
                border_color = fvgBorderBull,
                border_width = 1,
                bgcolor      = fvgBullColor,
                text         = "FVG",
                text_size    = size.tiny,
                text_color   = color.new(color.white, 30),
                text_halign  = text.align_right,
                text_valign  = text.align_center
            )
            array.push(activeFvgs, ActiveFvg.new(bx, fvgTop, fvgBtm, true, bar_index))
    
    // Bearish FVG: High nến 3 < Low nến 1
    if high < low[2]
        float fvgTop = low[2]
        float fvgBtm = high
        float fvgGap = ((fvgTop - fvgBtm) / fvgBtm) * 100
        if fvgGap >= fvgMinSize
            box bx = box.new(
                left         = bar_index - 1,
                top          = fvgTop,
                right        = bar_index + depthInput * 3,
                bottom       = fvgBtm,
                xloc         = xloc.bar_index,
                border_color = fvgBorderBear,
                border_width = 1,
                bgcolor      = fvgBearColor,
                text         = "FVG",
                text_size    = size.tiny,
                text_color   = color.new(color.white, 30),
                text_halign  = text.align_right,
                text_valign  = text.align_center
            )
            array.push(activeFvgs, ActiveFvg.new(bx, fvgTop, fvgBtm, false, bar_index))

if not showFvgInput and array.size(activeFvgs) > 0
    for item in activeFvgs
        box.delete(item.bx)
    array.clear(activeFvgs)

// Volume Profile cho N sóng gần nhất (chỉ tính toán và vẽ ở nến cuối cùng barstate.islast)
var array<box> vpBoxes = array.new_box()

if showVpInput and barstate.islast and pSize > 0
    if array.size(vpBoxes) > 0
        for bx in vpBoxes
            box.delete(bx)
        array.clear(vpBoxes)
    
    int barDuration = int(time - nz(time[1], time - 60000))
    if barDuration <= 0
        barDuration := 60000
    
    int startWaveIdx = math.max(0, pSize - vpWavesInput)
    for i = startWaveIdx to pSize - 1
        ZigZagLib.Pivot p = array.get(zigZag.pivots, i)
        if not na(p.ln)
            int   x1        = int(line.get_x1(p.ln))
            int   x2        = int(line.get_x2(p.ln))
            float y1        = line.get_y1(p.ln)
            float y2        = line.get_y2(p.ln)
            
            int   startTime = math.min(x1, x2)
            int   endTime   = math.max(x1, x2)
            float lowPrice  = math.min(y1, y2)
            float highPrice = math.max(y1, y2)
            int   timeSpan  = endTime - startTime
            
            if timeSpan > 0 and highPrice > lowPrice
                float priceStep = (highPrice - lowPrice) / vpRowsInput
                array<float> binVols = array.new_float(vpRowsInput, 0.0)
                
                int maxLookback = math.min(4999, bar_index)
                if maxLookback >= 0
                    for offset = 0 to maxLookback
                        int bTime = time[offset]
                        if na(bTime) or bTime < startTime
                            break
                        if bTime <= endTime
                            float bVol  = volume[offset]
                            float bHigh = high[offset]
                            float bLow  = low[offset]
                            if not na(bVol) and bVol > 0 and not na(bHigh) and not na(bLow)
                                int lowBin  = math.max(0, math.min(vpRowsInput - 1, int(math.floor((bLow - lowPrice) / priceStep))))
                                int highBin = math.max(0, math.min(vpRowsInput - 1, int(math.floor((bHigh - lowPrice) / priceStep))))
                                int span    = highBin - lowBin + 1
                                float volPerBin = bVol / span
                                for b = lowBin to highBin
                                    array.set(binVols, b, array.get(binVols, b) + volPerBin)
                
                float maxVol = array.max(binVols)
                int   pocIdx = array.indexof(binVols, maxVol)
                
                if maxVol > 0
                    for b = 0 to vpRowsInput - 1
                        float bVol = array.get(binVols, b)
                        if bVol > 0
                            float binBottom = lowPrice + b * priceStep
                            float binTop    = binBottom + priceStep
                            int   binWidth  = math.max(barDuration, int(math.round((bVol / maxVol) * timeSpan * 0.7)))
                            int   bLeft     = startTime
                            int   bRight    = startTime + binWidth
                            bool  isPoc     = (b == pocIdx) and showPocInput
                            color boxBg     = isPoc ? vpPocColor : (p.isHigh ? vpUpColor : vpDownColor)
                            color boxBorder = isPoc ? color.new(vpPocColor, 20) : color.new(boxBg, 80)
                            
                            box bx = box.new(
                                left         = bLeft,
                                top          = binTop,
                                right        = bRight,
                                bottom       = binBottom,
                                xloc         = xloc.bar_time,
                                border_color = boxBorder,
                                border_width = 1,
                                bgcolor      = boxBg
                            )
                            array.push(vpBoxes, bx)

if not showVpInput and barstate.islast and array.size(vpBoxes) > 0
    for bx in vpBoxes
        box.delete(bx)
    array.clear(vpBoxes)






// =========================================================================
// TẠO TÍN HIỆU LONG VÀ SHORT (ENTRY KHI KẾT THÚC SÓNG)
// =========================================================================
var int lastProcessedPivotCount = 0
bool isNewPivotConfirmed = (pSize > lastProcessedPivotCount)

bool isPrevWaveWeakDown       = false
bool isPrevPrevWaveStrongUp   = false
bool isPrevWaveWeakUp         = false
bool isPrevPrevWaveStrongDown = false

if pSize >= 3
    ZigZagLib.Pivot lastP = array.get(zigZag.pivots, pSize - 1)
    ZigZagLib.Pivot prevP = array.get(zigZag.pivots, pSize - 2)
    
    // --- Điều kiện Long: Sóng giảm vừa kết thúc (Swing Low) ---
    if not lastP.isHigh
        int lastPWidth = 1
        if pSize >= 3
            ZigZagLib.Pivot prevDown = array.get(zigZag.pivots, pSize - 3)
            if not na(lastP.vol) and not na(prevDown.vol) and lastP.vol > prevDown.vol
                lastPWidth := 2
        isPrevWaveWeakDown := (lastPWidth == 1)
        
        if prevP.isHigh
            int prevPWidth = 1
            if pSize >= 4
                ZigZagLib.Pivot prevPrevUp = array.get(zigZag.pivots, pSize - 4)
                if not na(prevP.vol) and not na(prevPrevUp.vol) and prevP.vol > prevPrevUp.vol
                    prevPWidth := 2
            isPrevPrevWaveStrongUp := (prevPWidth == 2)
    
    // --- Điều kiện Short: Sóng tăng vừa kết thúc (Swing High) ---
    if lastP.isHigh
        int lastPWidth = 1
        if pSize >= 3
            ZigZagLib.Pivot prevUp = array.get(zigZag.pivots, pSize - 3)
            if not na(lastP.vol) and not na(prevUp.vol) and lastP.vol > prevUp.vol
                lastPWidth := 2
        isPrevWaveWeakUp := (lastPWidth == 1)
        
        if not prevP.isHigh
            int prevPWidth = 1
            if pSize >= 4
                ZigZagLib.Pivot prevPrevDown = array.get(zigZag.pivots, pSize - 4)
                if not na(prevP.vol) and not na(prevPrevDown.vol) and prevP.vol > prevPrevDown.vol
                    prevPWidth := 2
            isPrevPrevWaveStrongDown := (prevPWidth == 2)

// Cấu trúc sóng hợp lệ
bool validLongWaveStructure  = isPrevWaveWeakDown and isPrevPrevWaveStrongUp
bool validShortWaveStructure = isPrevWaveWeakUp and isPrevPrevWaveStrongDown

// Stoploss & Takeprofit cho Long:
// Lấy giá đáy của con sóng giảm vừa hoàn thành
ZigZagLib.Pivot lastPivotObj = (pSize > 0) ? array.get(zigZag.pivots, pSize - 1) : na
float pivotLowPrice = (not na(lastPivotObj) and not na(lastPivotObj.ln)) ? math.min(line.get_y1(lastPivotObj.ln), line.get_y2(lastPivotObj.ln)) : ta.lowest(low, depthInput)[1]
float slPrice       = math.min(pivotLowPrice, ta.lowest(low, depthInput)[1])
float slDist        = close - slPrice
// Đảm bảo khoảng cách SL tối thiểu 0.5 * ATR để tránh bị quét SL tức thì
if slDist < ta.atr(14) * 0.5
    slDist  := ta.atr(14) * 1.5
    slPrice := close - slDist
float tpPrice = close + (slDist * rrrInput)

// Stoploss & Takeprofit cho Short:
// Lấy giá đỉnh của con sóng tăng vừa hoàn thành
float pivotHighPrice = (not na(lastPivotObj) and not na(lastPivotObj.ln)) ? math.max(line.get_y1(lastPivotObj.ln), line.get_y2(lastPivotObj.ln)) : ta.highest(high, depthInput)[1]
float shortSlPrice   = math.max(pivotHighPrice, ta.highest(high, depthInput)[1])
float shortSlDist    = shortSlPrice - close
// Đảm bảo khoảng cách SL tối thiểu 0.5 * ATR
if shortSlDist < ta.atr(14) * 0.5
    shortSlDist  := ta.atr(14) * 1.5
    shortSlPrice := close + shortSlDist
float shortTpPrice = close - (shortSlDist * rrrInput)

// Kích hoạt Long khi kết thúc sóng giảm thỏa điều kiện VÀ không có vị thế Short đang mở
bool longSignal = showLongSignals and isNewPivotConfirmed and validLongWaveStructure and strategy.position_size >= 0

// Kích hoạt Short khi kết thúc sóng tăng thỏa điều kiện VÀ không có vị thế Long đang mở
bool shortSignal = showShortSignals and isNewPivotConfirmed and validShortWaveStructure and strategy.position_size <= 0

// Đỉnh sóng 1 mạnh (lineWidth = 2) cho Long
ZigZagLib.Pivot wave1P_Long = (pSize >= 2) ? array.get(zigZag.pivots, pSize - 2) : na
float tp1Long = (not na(wave1P_Long) and not na(wave1P_Long.ln)) ? math.max(line.get_y1(wave1P_Long.ln), line.get_y2(wave1P_Long.ln)) : high
float tp2Long = tpPrice

// Đáy sóng 1 mạnh (lineWidth = 2) cho Short
ZigZagLib.Pivot wave1P_Short = (pSize >= 2) ? array.get(zigZag.pivots, pSize - 2) : na
float tp1Short = (not na(wave1P_Short) and not na(wave1P_Short.ln)) ? math.min(line.get_y1(wave1P_Short.ln), line.get_y2(wave1P_Short.ln)) : low
float tp2Short = shortTpPrice

// Tìm mức đáy sóng giảm gần nhất (Recent Down Wave Low) và đỉnh sóng tăng gần nhất (Recent Up Wave High)
float latestDownWaveLow = na
float latestUpWaveHigh  = na

if pSize > 0
    for k = pSize - 1 to math.max(0, pSize - 4)
        ZigZagLib.Pivot p = array.get(zigZag.pivots, k)
        if not na(p.ln)
            if na(latestDownWaveLow) and not p.isHigh
                latestDownWaveLow := math.min(line.get_y1(p.ln), line.get_y2(p.ln))
            if na(latestUpWaveHigh) and p.isHigh
                latestUpWaveHigh := math.max(line.get_y1(p.ln), line.get_y2(p.ln))
        if not na(latestDownWaveLow) and not na(latestUpWaveHigh)
            break

// Biến theo dõi trạng thái đã chốt lời 50% (TP1) cho vị thế hiện tại
var bool  isLongPartialFilled  = false
var bool  isShortPartialFilled = false
var float activeTp1Long        = na
var float activeTp1Short       = na

// Cập nhật trạng thái TP1 khi giá chạm mốc TP1 trong quá trình giữ vị thế
if strategy.position_size > 0
    if not na(activeTp1Long) and high >= activeTp1Long
        isLongPartialFilled := true
else if strategy.position_size < 0
    if not na(activeTp1Short) and low <= activeTp1Short
        isShortPartialFilled := true
else
    isLongPartialFilled  := false
    isShortPartialFilled := false
    activeTp1Long        := na
    activeTp1Short       := na

// Lấy nến vào lệnh gần nhất để ngăn việc đóng lệnh ngay trên cây nến vừa mở
int lastEntryBar = (strategy.opentrades > 0) ? strategy.opentrades.entry_bar_index(strategy.opentrades - 1) : -1

// Thực thi Strategy Entry / Exit
// 1. Đóng phần còn lại của Long nếu giá phá đáy 1 sóng giảm (CHỈ THỰC HIỆN SAU KHI ĐÃ PARTIAL EXIT)
if strategy.position_size > 0 and bar_index > lastEntryBar and isLongPartialFilled and not na(latestDownWaveLow)
    if close < latestDownWaveLow
        strategy.close("Long", comment = "Close Long Post-TP1 (Break Wave Low)")

// 2. Đóng phần còn lại của Short nếu giá phá đỉnh 1 sóng tăng (CHỈ THỰC HIỆN SAU KHI ĐÃ PARTIAL EXIT)
if strategy.position_size < 0 and bar_index > lastEntryBar and isShortPartialFilled and not na(latestUpWaveHigh)
    if close > latestUpWaveHigh
        strategy.close("Short", comment = "Close Short Post-TP1 (Break Wave High)")

// 3. Vào lệnh Long: Chốt lời 50% tại đỉnh cũ sóng mạnh (TP1), 50% còn lại theo RRR (TP2), dừng lỗ tại SL
if longSignal
    isLongPartialFilled := false
    activeTp1Long       := (partialTpInput and tp1Long > close) ? tp1Long : na
    strategy.entry("Long", strategy.long)
    if partialTpInput and tp1Long > close
        strategy.exit("TP1 Long", from_entry = "Long", qty_percent = 50, limit = tp1Long, stop = slPrice, comment_profit = "TP1 Long", comment_loss = "SL Long")
        strategy.exit("TP2 Long", from_entry = "Long", limit = tp2Long, stop = slPrice, comment_profit = "TP2 Long", comment_loss = "SL Long")
    else
        strategy.exit("Exit Long", from_entry = "Long", stop = slPrice, limit = tp2Long, comment_profit = "TP Long", comment_loss = "SL Long")

// 4. Vào lệnh Short: Chốt lời 50% tại đáy cũ sóng mạnh (TP1), 50% còn lại theo RRR (TP2), dừng lỗ tại SL
if shortSignal
    isShortPartialFilled := false
    activeTp1Short        := (partialTpInput and tp1Short < close) ? tp1Short : na
    strategy.entry("Short", strategy.short)
    if partialTpInput and tp1Short < close
        strategy.exit("TP1 Short", from_entry = "Short", qty_percent = 50, limit = tp1Short, stop = shortSlPrice, comment_profit = "TP1 Short", comment_loss = "SL Short")
        strategy.exit("TP2 Short", from_entry = "Short", limit = tp2Short, stop = shortSlPrice, comment_profit = "TP2 Short", comment_loss = "SL Short")
    else
        strategy.exit("Exit Short", from_entry = "Short", stop = shortSlPrice, limit = tp2Short, comment_profit = "TP Short", comment_loss = "SL Short")

// Cập nhật số lượng pivot đã xử lý sau khi đã thực thi logic tín hiệu
if isNewPivotConfirmed
    lastProcessedPivotCount := pSize

// =========================================================================
// HIỂN THỊ TARGET LINES VÀ LABELS TRÊN BIỂU ĐỒ
// =========================================================================
var line  entryLine = na
var line  slLine    = na
var line  tpLine1   = na
var line  tpLine2   = na
var label sigLabel  = na

int lineEndBar = bar_index + depthInput * 4

if longSignal and showTpSlLines
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine1)
    line.delete(tpLine2)
    label.delete(sigLabel)
    
    entryLine := line.new(bar_index, close, lineEndBar, close, color = color.white, style = line.style_dashed, width = 1)
    slLine    := line.new(bar_index, slPrice, lineEndBar, slPrice, color = #F23645, width = 2)
    if partialTpInput and tp1Long > close
        tpLine1 := line.new(bar_index, tp1Long, lineEndBar, tp1Long, color = #FFB300, style = line.style_dashed, width = 1)
    tpLine2   := line.new(bar_index, tp2Long, lineEndBar, tp2Long, color = #00E676, width = 2)
    
    string labelText = "LONG SIGNAL\nEntry: " + str.tostring(close, "#.##") + "\nSL: " + str.tostring(slPrice, "#.##")
    if partialTpInput and tp1Long > close
        labelText += "\nTP1 (50% Đỉnh cũ): " + str.tostring(tp1Long, "#.##")
        labelText += "\nTP2 (50% RRR): " + str.tostring(tp2Long, "#.##")
    else
        labelText += "\nTP: " + str.tostring(tp2Long, "#.##") + " (RRR 1:" + str.tostring(rrrInput, "#.#") + ")"
    
    // Đặt label tại góc dưới cùng bên phải của cụm đường mục tiêu (x = lineEndBar, y = slPrice)
    sigLabel  := label.new(
        lineEndBar,
        slPrice,
        text      = labelText,
        color     = color.new(#131722, 10),
        textcolor = color.white,
        style     = label.style_label_left,
        size      = size.small
    )

if shortSignal and showTpSlLines
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine1)
    line.delete(tpLine2)
    label.delete(sigLabel)
    
    entryLine := line.new(bar_index, close, lineEndBar, close, color = color.white, style = line.style_dashed, width = 1)
    slLine    := line.new(bar_index, shortSlPrice, lineEndBar, shortSlPrice, color = #F23645, width = 2)
    if partialTpInput and tp1Short < close
        tpLine1 := line.new(bar_index, tp1Short, lineEndBar, tp1Short, color = #FFB300, style = line.style_dashed, width = 1)
    tpLine2   := line.new(bar_index, shortTpPrice, lineEndBar, shortTpPrice, color = #00E676, width = 2)
    
    string labelText = "SHORT SIGNAL\nEntry: " + str.tostring(close, "#.##") + "\nSL: " + str.tostring(shortSlPrice, "#.##")
    if partialTpInput and tp1Short < close
        labelText += "\nTP1 (50% Đáy cũ): " + str.tostring(tp1Short, "#.##")
        labelText += "\nTP2 (50% RRR): " + str.tostring(shortTpPrice, "#.##")
    else
        labelText += "\nTP: " + str.tostring(shortTpPrice, "#.##") + " (RRR 1:" + str.tostring(rrrInput, "#.#") + ")"
    
    // Đặt label tại góc dưới cùng bên phải của cụm đường mục tiêu (x = lineEndBar, y = shortTpPrice)
    sigLabel  := label.new(
        lineEndBar,
        shortSlPrice,
        text      = labelText,
        color     = color.new(#131722, 10),
        textcolor = color.white,
        style     = label.style_label_left,
        size      = size.small
    )

// Xóa Entry, SL, TP Lines và Label khi vị thế được đóng (bằng SL, Close, hoặc TP hoàn tất)
if strategy.position_size == 0
    line.delete(entryLine)
    line.delete(slLine)
    line.delete(tpLine1)
    line.delete(tpLine2)
    label.delete(sigLabel)

// Cấu hình Alerts
alertcondition(longSignal, title = "Long Signal Alert", message = "Long Signal Triggered! Entry: {{close}}, SL: {{plot_0}}, TP: {{plot_1}}")
alertcondition(shortSignal, title = "Short Signal Alert", message = "Short Signal Triggered! Entry: {{close}}, SL: {{plot_0}}, TP: {{plot_1}}")
