//@version=6
strategy(
     title                   = "Supertrend VWAP Strategy",
     shorttitle              = "Supertrend VWAP",
     overlay                 = true,
     initial_capital         = 100000,
     currency                = currency.USD,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 30,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.05,
     process_orders_on_close = true,
     max_lines_count         = 500,
     max_labels_count        = 500,
     max_boxes_count         = 500
)

// ==============================================================================
// 1. CẤU HÌNH & THAM SỐ ĐẦU VÀO (INPUTS)
// ==============================================================================

// --- Group 0: Cấu hình Chung ---
grp_common      = "Common"
templateChoice  = input.string("None", "Template", options = ["None", "Scalp using Supertrend", "Scalp using VWAP", "VCP"], group = grp_common, tooltip = "Chọn Template cấu hình có sẵn:\n- None: Sử dụng cài đặt thủ công từng mục bên dưới.\n- Scalp using Supertrend: Bộ thông số tối ưu cho Scalping theo Supertrend.\n- Scalp using VWAP: Bộ thông số tối ưu cho Scalping theo Anchored VWAP.\n- VCP: Cấu hình chiến lược tích lũy VCP (Sideway VCP, Follow Trend, VWAP Tắt, Break Sideway, SL Sideway Zone, Dời SL về BE tại TP1, Đóng vị thế: None).")
htfTf           = input.string("D1", "HTF", options = ["M5", "M30", "H4", "D1", "W1"], group = grp_common, tooltip = "Khung thời gian lớn để tính ATR 6 phiên khi chọn Take Profit Type là ATR (HTF).")

// --- Group 1: Cấu hình Supertrend & Adaptive Mode ---
grp_st          = "1. Cấu hình Supertrend & Chế độ Adaptive"
isAdaptive      = input.bool(true, "Is Adaptive Supertrend", group = grp_st, tooltip = "Khi BẬT: ATR Period và Factor sẽ tự động co giãn theo độ biến động và độ nhiễu thị trường (Period: 5-20, Factor: 2.0-5.0).\nKhi TẮT: Sử dụng thông số cố định bên dưới (Mặc định 10, 3.0).")
stTrendType     = input.string("Strong Trend", "Filter by Supertrend", options = ["Follow Trend", "Counter Trend", "Swing", "Strong Trend"], group = grp_st, tooltip = "Chọn hướng/chế độ lọc theo Supertrend:\n- Follow Trend: Long khi giá nằm trên Supertrend, Short khi giá nằm dưới Supertrend.\n- Counter Trend: Long khi giá nằm dưới Supertrend, Short khi giá nằm trên Supertrend.\n- Swing: Long khi Supertrend sóng tăng < Supertrend sóng giảm trước đó; Short khi Supertrend sóng giảm > Supertrend sóng tăng trước đó.\n- Strong Trend: Long khi Supertrend sóng tăng > Supertrend sóng giảm trước đó; Short khi Supertrend sóng giảm < Supertrend sóng tăng trước đó.")
fixedPeriod     = input.int(10, "ATR Period (Cố định khi tắt Adaptive)", minval = 1, group = grp_st, tooltip = "Chu kỳ ATR cố định khi không sử dụng chế độ Adaptive (Mặc định: 10)")
fixedFactor     = input.float(3.0, "Multiplier Factor (Cố định khi tắt Adaptive)", minval = 0.1, step = 0.1, group = grp_st, tooltip = "Hệ số nhân cố định khi không sử dụng chế độ Adaptive (Mặc định: 3.0)")

// Giới hạn Adaptive
grp_adapt_lim   = "1.1. Giới hạn dải Adaptive"
minPeriod       = input.int(5, "Adaptive Min Period", minval = 1, maxval = 50, group = grp_adapt_lim, tooltip = "Chu kỳ ATR tối thiểu khi thị trường có xu hướng mạnh (Mặc định: 5)")
maxPeriod       = input.int(20, "Adaptive Max Period", minval = 1, maxval = 100, group = grp_adapt_lim, tooltip = "Chu kỳ ATR tối đa khi thị trường đi ngang / nhiều nhiễu (Mặc định: 20)")
minFactor       = input.float(2.0, "Adaptive Min Factor", minval = 0.5, maxval = 10.0, step = 0.1, group = grp_adapt_lim, tooltip = "Hệ số nhân tối thiểu khi thị trường êm ả / trend mượt (Mặc định: 2.0)")
maxFactor       = input.float(5.0, "Adaptive Max Factor", minval = 1.0, maxval = 15.0, step = 0.1, group = grp_adapt_lim, tooltip = "Hệ số nhân tối đa khi thị trường biến động giật / nhiễu (Mặc định: 5.0)")

// Group 1.2: Bộ lọc Xu hướng VWAP Anchor ---
grp_vwap        = "1.2. Bộ lọc Xu hướng VWAP Anchor"
useVwapFilter   = input.bool(false, "Bật bộ lọc Xu hướng VWAP Anchor", group = grp_vwap, tooltip = "Lọc tín hiệu vào lệnh dựa trên tương quan vị trí giữa giá đóng cửa và đường Anchored VWAP.")
vwapAnchor      = input.string("Day", "Chu kỳ neo VWAP (Anchor Period)", options = ["Year", "Quarter", "Month", "Week", "Day"], group = grp_vwap, tooltip = "Chu kỳ thời gian neo lại đường VWAP:\n- Year: Đầu mỗi năm\n- Quarter: Đầu mỗi quý (3 tháng)\n- Month: Đầu mỗi tháng\n- Week: Đầu mỗi tuần\n- Day: Đầu mỗi ngày")
vwapTrendType   = input.string("Follow Trend", "Filter by VWAP", options = ["Follow Trend", "Counter Trend"], group = grp_vwap, tooltip = "Follow Trend: Long khi giá trên VWAP, Short khi giá dưới VWAP.\nCounter Trend: Long khi giá dưới VWAP, Short khi giá trên VWAP.")
mustInMiddle    = input.string("None", "Điều kiện vùng giữa VWAP (mustInMiddle)", options = ["In Middle", "Out Middle", "None"], group = grp_vwap, tooltip = "In Middle: Entry phải nằm giữa Upper 1 và Lower 1 của VWAP.\nOut Middle: Entry phải nằm ngoài Upper 1 và Lower 1 của VWAP.\nNone: Logic như cũ, không lọc theo điều kiện này.")
showVwapLine    = input.bool(true, "Vẽ đường Anchored VWAP trên biểu đồ", group = grp_vwap)
showVwapBands   = input.bool(true, "Vẽ 3 dải Upper/Lower của VWAP", group = grp_vwap, tooltip = "Vẽ 3 dải Upper và 3 dải Lower tính theo độ lệch chuẩn StDev của VWAP (Dải 1 cố định tỷ lệ 1.0, Dải 2 dùng TP1, Dải 3 dùng TP2).")

// --- Group 1.3: Bộ lọc Candle Spread ---
grp_spread       = "1.3 Spread filter"
spreadFilterType = input.string("None", "Spread filter", options = ["None", "Spread Bùng nổ >= 80%", "Spread Mở rộng 50-80%", "Spread Bình thường 20-50%", "Spread nén <= 20%"], group = grp_spread, tooltip = "Chọn điều kiện lọc Entry theo phân vị biên độ nến (Spread = High - Low) trong 100 nến trước:\n- None: Không lọc\n- Spread Bùng nổ >= 80%: Chỉ vào lệnh khi Spread >= P80\n- Spread Mở rộng 50-80%: Chỉ vào lệnh khi Spread nằm trong khoảng 50% - 80%\n- Spread Bình thường 20-50%: Chỉ vào lệnh khi Spread nằm trong khoảng 20% - 50%\n- Spread nén <= 20%: Chỉ vào lệnh khi Spread <= P20")
spreadLookback   = input.int(100, "Spread Lookback", minval = 5, group = grp_spread, tooltip = "Chu kỳ số nến tính phân vị Spread (Mặc định: 100)")

// --- Group 1.4: Kiểm định Walk-Forward Analysis (WFA) ---
grp_wfa          = "1.4. Kiểm định Walk-Forward Analysis (WFA)"
enableWfa        = input.bool(false, "Bật Walk-Forward Analysis (WFA)", group = grp_wfa, tooltip = "Bật tính năng chia chu kỳ kiểm định Walk-Forward (In-Sample / Out-of-Sample) theo khung thời gian đã chọn.")
wfaTf            = input.string("D1", "Chu kỳ WFA (Timeframe Cycle)", options = ["M5", "M15", "M30", "H1", "H4", "D1", "W1", "M1 (Tháng)"], group = grp_wfa, tooltip = "Chọn khung thời gian cho mỗi chu kỳ WFA:\n- Ví dụ: Chart M1 và chọn D1 thì mỗi chu kỳ là 1 ngày.\n- Chọn W1 thì mỗi chu kỳ là 1 tuần.\n- Chọn H1 thì mỗi chu kỳ là 1 giờ.\n- Chọn M1 (Tháng) thì mỗi chu kỳ là 1 tháng.")
wfaCycleOffset   = input.int(0, "Dịch chuyển chu kỳ WFA (Cycle Shift / Offset)", minval = -500, maxval = 500, step = 1, group = grp_wfa, tooltip = "Dịch chuyển vùng kiểm định WFA sang chu kỳ tiếp theo (+1, +2, ...) hoặc chu kỳ trước (-1, -2, ...):\n- Với D1: +1 sẽ chuyển vùng WFA sang ngày tiếp theo.\n- Với W1: +1 sẽ chuyển vùng WFA sang tuần tiếp theo.")
wfaScope         = input.string("Tất cả các chu kỳ", "Phạm vi kiểm định (WFA Scope)", options = ["Tất cả các chu kỳ", "Chỉ 1 chu kỳ mục tiêu (Single Cycle)", "Từ chu kỳ mục tiêu trở đi (From Cycle N)"], group = grp_wfa, tooltip = "Tất cả các chu kỳ: Áp dụng WFA liên tục trên toàn bộ lịch sử biểu đồ.\nChỉ 1 chu kỳ mục tiêu: Chỉ kiểm định duy nhất 1 chu kỳ (ví dụ chỉ 1 ngày hoặc 1 tuần cụ thể).\nTừ chu kỳ mục tiêu trở đi: Bắt đầu kiểm định từ chu kỳ được chọn đến hiện tại.")
wfaTargetCycle   = input.int(1, "Số thứ tự chu kỳ mục tiêu (Target Cycle #)", minval = 1, maxval = 9999, step = 1, group = grp_wfa, tooltip = "Chọn số thứ tự chu kỳ (Cycle Index) để kiểm định khi chọn phạm vi Single Cycle hoặc From Cycle N.")
wfaMode          = input.string("Chỉ kiểm định Out-of-Sample (OOS)", "Chế độ kiểm định (WFA Mode)", options = ["Chỉ kiểm định Out-of-Sample (OOS)", "Chỉ kiểm định In-Sample (IS)", "Toàn bộ chu kỳ (Cả IS & OOS)", "Chu kỳ xen kẽ (Xen kẽ 1 chu kỳ IS, 1 chu kỳ OOS)"], group = grp_wfa, tooltip = "Chọn chế độ thực hiện lệnh trong chu kỳ WFA:\n- Chỉ kiểm định Out-of-Sample (OOS): Chỉ mở lệnh trong phần Out-of-Sample (Mặc định 30% cuối mỗi chu kỳ) để kiểm tra độ tin cậy của chiến lược.\n- Chỉ kiểm định In-Sample (IS): Chỉ mở lệnh trong phần In-Sample (70% đầu mỗi chu kỳ).\n- Toàn bộ chu kỳ (Cả IS & OOS): Mở lệnh trên toàn bộ chu kỳ và vẽ Box phân vùng để theo dõi.\n- Chu kỳ xen kẽ: Chu kỳ lẻ là IS, Chu kỳ chẵn là OOS.")
wfaOosPercent    = input.int(30, "Tỷ lệ Out-of-Sample (% OOS trong mỗi chu kỳ)", minval = 5, maxval = 95, step = 5, group = grp_wfa, tooltip = "Tỷ lệ phần trăm thời gian của mỗi chu kỳ dành cho Out-of-Sample (Mặc định: 30% OOS, 70% In-Sample).")
wfaShowBoxes     = input.bool(true, "Vẽ Box trực quan vùng WFA (OOS)", group = grp_wfa, tooltip = "Vẽ khung chữ nhật bao quanh vùng kiểm định Out-of-Sample (OOS) của từng chu kỳ.")
wfaShowBg        = input.bool(false, "Tô màu nền vùng Out-of-Sample (OOS Background)", group = grp_wfa, tooltip = "Tô màu nền tím nhẹ tại các nến thuộc vùng kiểm định Out-of-Sample.")

// --- Group 2: Nhận diện Sideway (Sideway Up & Sideway Down) ---
grp_side        = "2. Nhận diện Trạng thái Sideway"
detectSideway   = input.bool(true, "Bật tính năng phát hiện Sideway", group = grp_side, tooltip = "Phát hiện thị trường đi ngang ngay cả khi giá vẫn nằm trên Supertrend (Sideway Up) hoặc dưới Supertrend (Sideway Down).")
sidewayMethod   = input.string("Narrow Sideway", "Sideway method", options = ["Narrow Sideway", "VCP", "Kết hợp (ADX + Kaufman ER + CHOP)", "ADX Thấp", "Choppiness Index Cao", "Kaufman ER Thấp", "Biên độ nén BB Width"], group = grp_side, tooltip = "Chọn phương pháp nhận diện vùng tích lũy / Sideway:\n- Narrow Sideway: Price Action nén biên độ & FVG.\n- VCP: Mẫu hình thu hẹp biến động (Volatility Contraction Pattern) theo dải VMA ATR Bands (ubx & lbx). VCP Up: toàn bộ Open nằm trong dải Bands, không có Low < Lower Band, tối thiểu 2 nến High < Upper Band, kết thúc khi Close > Upper Band. VCP Down: toàn bộ Open nằm trong dải Bands, không có High > Upper Band, tối thiểu 2 nến Low > Lower Band, kết thúc khi Close < Lower Band. Tối thiểu 3 nến trước khi Break.\n- Kết hợp (ADX + Kaufman ER + CHOP): Bộ lọc đa chỉ báo.")
vmaLen          = input.int(5, "VMA Length (VCP / Reversal)", minval = 1, group = grp_side, tooltip = "Chu kỳ VMA (Variable Moving Average) phục vụ nhận diện VCP và VMA Reversal (Mặc định: 5)")
vmaMult         = input.float(1, "VMA Bands Multiplier", minval = 0.1, step = 0.1, group = grp_side, tooltip = "Hệ số nhân ATR Bands cho VMA (Mặc định: 1.0)")
adxThresh       = input.float(20.0, "Ngưỡng ADX (Dưới ngưỡng là Sideway)", minval = 5.0, maxval = 50.0, step = 1.0, group = grp_side, tooltip = "Chỉ số ADX dưới mức này báo hiệu lực xu hướng yếu / tích lũy (Mặc định: 20)")
chopThresh      = input.float(60.0, "Ngưỡng Choppiness Index (Trên ngưỡng là Sideway)", minval = 30.0, maxval = 90.0, step = 1.0, group = grp_side, tooltip = "Chỉ số CHOP trên mức này báo hiệu thị trường giật cục / không có xu hướng (Mặc định: 60)")
erThresh        = input.float(0.30, "Ngưỡng Kaufman ER (Dưới ngưỡng là Sideway)", minval = 0.05, maxval = 0.9, step = 0.05, group = grp_side, tooltip = "Hiệu suất di chuyển giá Kaufman ER dưới mức này thể hiện nhiều nến chồng chéo / nhiễu (Mặc định: 0.30)")

// --- Group 3: Quản lý Vào lệnh & Tỷ lệ RRR (Entry / SL / TP1 / TP2) ---
grp_trade       = "3. Quản lý Vào lệnh & Thoát lệnh RRR"
allowLong       = input.bool(true, "Cho phép lệnh Long (Mua)", group = grp_trade)
allowShort      = input.bool(true, "Cho phép lệnh Short (Bán)", group = grp_trade)
filterSideway   = input.bool(false, "Không mở vị thế mới nếu đang Sideway", group = grp_trade, tooltip = "Nếu bật, khi có tín hiệu vào lệnh nhưng thị trường đang nằm trong vùng Sideway sẽ bỏ qua.")
entryType       = input.string("Breakout", "Kiểu vào lệnh (Entry Type)", options = ["Supertrend Flip", "Break Sideway", "First Pullback", "Pullback + Sideway", "Breakout", "Breakdown", "VMA Reversal"], group = grp_trade, tooltip = "Supertrend Flip: Vào lệnh ngay khi Supertrend đảo chiều xu hướng.\nBreak Sideway: Vào lệnh khi giá phá vỡ đỉnh (Long) hoặc đáy (Short) của bất kỳ vùng Sideway nào khi chưa có lệnh.\nFirst Pullback: Vào lệnh sau khi kết thúc vùng First Pullback đầu tiên của sóng Supertrend mà giá vẫn duy trì xu hướng.\nPullback + Sideway: Cho phép vào lệnh khi xảy ra Pullback hoặc Sideway. Sau khi lệnh Pullback chốt lời, vẫn tiếp tục vào thêm lệnh nếu xuất hiện Break Sideway.\nBreakout: Vào lệnh Long khi phá vỡ High nến trước và nằm trên Supertrend tăng; Short khi phá vỡ Low nến trước và nằm dưới Supertrend giảm.\nBreakdown: Vào lệnh Long khi giá đóng nến đỏ phá Low nến trước (close < open và close < low[1]); Short khi giá đóng nến xanh phá High nến trước (close > open và close > high[1]).\nVMA Reversal: Long khi xuất hiện Signal Bar (Open < VMA và Close > VMA, trong vmaLen nến trước có Low < lband) và Entry Bar khi Close > High Signal Bar; Short khi xuất hiện Signal Bar (Open > VMA và Close < VMA, trong vmaLen nến trước có High > uband) và Entry Bar khi Close < Low Signal Bar.")
slType          = input.string("Supertrend", "Kiểu Stop Loss (Stoploss Type)", options = ["Supertrend", "Sideway Zone", "Entry Candle", "Previous Candle"], group = grp_trade, tooltip = "Supertrend: Đặt SL theo đường Supertrend tại thời điểm vào lệnh.\nSideway Zone: Đặt SL dưới đáy vùng Sideway (Long) hoặc trên đỉnh vùng Sideway (Short).\nEntry Candle: Đặt SL tại Low của nến Entry (Long) hoặc High của nến Entry (Short).\nPrevious Candle: Đặt SL tại Low của nến trước đó (Long) hoặc High của nến trước đó (Short).")
tpType          = input.string("Percent", "Kiểu tính khoảng cách TP theo RRR (RRR Distance Type)", options = ["ATR", "ATR (HTF)", "Percent", "Spread", "VWAP"], group = grp_trade, tooltip = "Sử dụng khi TP1/TP2 chọn chế độ 'Theo RRR / Tỷ lệ' (By RRR):\n- ATR: Khoảng cách = Hệ số nhân x ATR.\n- ATR (HTF): Khoảng cách = Hệ số nhân x ATR(6) HTF.\n- Percent: Khoảng cách = Hệ số nhân x Risk ban đầu (Entry - SL).\n- Spread: Khoảng cách = Số tick x Bước giá tối thiểu (syminfo.mintick).\n- VWAP: Chốt lời theo dải Upper 2/3 (Long) hoặc Lower 2/3 (Short) của VWAP.")
tp1Mode         = input.string("Theo RRR / Tỷ lệ", "Phương thức Take Profit 1 (TP1)", options = ["Theo RRR / Tỷ lệ", "Next (n) Candle", "Breakout2", "Breakout3", "FVG"], group = grp_trade, tooltip = "Theo RRR / Tỷ lệ: Chốt lời theo giá trị rrrTp1 và kiểu tpType.\nNext (n) Candle: Thoát lệnh sau n nến kể từ nến Entry (với n = rrrTp1, ví dụ rrrTp1 = 1 là thoát tại nến kế tiếp sau nến Entry).\nBreakout2: Chốt lời khi giá đóng cửa cao hơn (Long) / thấp hơn (Short) 2 nến trước đó, cách nến Entry tối thiểu 3 nến và đang có lời (close > entryPrice cho Long, close < entryPrice cho Short).\nBreakout3: Chốt lời khi giá đóng cửa cao hơn (Long) / thấp hơn (Short) 3 nến trước đó, cách nến Entry tối thiểu 3 nến và đang có lời.\nFVG: Chốt lời khi xuất hiện FVG (nến [2] xảy ra sau nến Entry) và đang có lời.")
rrrTp1          = input.float(2.0, "Input for TP1", minval = 0.0001, step = 0.01, group = grp_trade, tooltip = "Khi chọn Theo RRR: Khoảng cách TP1 = Entry ± rrrTp1 * (Risk, ATR, ATR HTF, syminfo.mintick hoặc VWAP StDev).\nKhi chọn Next (n) Candle: Số cây nến nắm giữ trước khi chốt lời TP1 (Mặc định: 2.0)")
tp1QtyPct       = input.float(50.0, "% Khối lượng chốt lời tại TP1", minval = 1.0, maxval = 100.0, step = 5.0, group = grp_trade, tooltip = "Tỷ lệ phần trăm vị thế sẽ chốt lời khi chạm TP1 (Mặc định: 50%)")
tp2Mode         = input.string("Theo RRR / Tỷ lệ", "Phương thức Take Profit 2 (TP2)", options = ["Theo RRR / Tỷ lệ", "Next (n) Candle", "Breakout2", "Breakout3", "FVG"], group = grp_trade, tooltip = "Theo RRR / Tỷ lệ: Chốt lời theo giá trị rrrTp2 và kiểu tpType.\nNext (n) Candle: Thoát lệnh sau n nến kể từ nến Entry (với n = rrrTp2).\nBreakout2: Chốt lời khi giá đóng cửa cao hơn (Long) / thấp hơn (Short) 2 nến trước đó, cách nến Entry tối thiểu 3 nến và đang có lời.\nBreakout3: Chốt lời khi giá đóng cửa cao hơn (Long) / thấp hơn (Short) 3 nến trước đó, cách nến Entry tối thiểu 3 nến và đang có lời.\nFVG: Chốt lời khi xuất hiện FVG (nến [2] xảy ra sau nến Entry) và đang có lời.")
rrrTp2          = input.float(4.0, "Input for TP2", minval = 0.0001, step = 0.01, group = grp_trade, tooltip = "Khi chọn Theo RRR: Khoảng cách TP2 = Entry ± rrrTp2 * (Risk, ATR, ATR HTF, syminfo.mintick hoặc VWAP StDev).\nKhi chọn Next (n) Candle: Số cây nến nắm giữ trước khi chốt lời TP2 (Mặc định: 4.0)")
moveSlToBe      = input.string("TP 1", "Dời SL về Hòa vốn (Break-Even)", options = ["RRR = 1", "TP 1", "TP 2", "None"], group = grp_trade, tooltip = "Tự động dời Stoploss về giá Entry khi giá đạt các mốc sau:\n- RRR = 1: Khi giá đi được 1R (bằng khoảng cách Risk ban đầu).\n- TP 1: Khi giá chạm mức chốt lời TP1.\n- TP 2: Khi giá chạm mức chốt lời TP2.\n- None: Giữ nguyên Stoploss ban đầu.")
closePosMode   = input.string("Supertrend đảo ngược chiều", "Đóng vị thế còn lại (Close Position When)", options = ["Breakdown2", "Breakdown3", "Supertrend đảo ngược chiều", "Chạm VWAP", "None"], group = grp_trade, tooltip = "Điều kiện đóng toàn bộ vị thế còn lại:\n- Breakdown2: Đóng khi giá đảo chiều Breakdown qua 2 nến trước nó (Long: close < min(low[1], low[2]), Short: close > max(high[1], high[2])).\n- Breakdown3: Đóng khi giá đảo chiều Breakdown qua 3 nến trước nó (Long: close < min(low[1], low[2], low[3]), Short: close > max(high[1], high[2], high[3])).\n- Supertrend đảo ngược chiều: Đóng khi Supertrend đổi hướng ngược vị thế.\n- Chạm VWAP: Đóng khi giá chạm lại đường Anchored VWAP (Long: low <= vwapValue, Short: high >= vwapValue).\n- None: Không chủ động đóng theo các điều kiện trên.")

// --- Group 4: Hiển thị & Đồ họa ---
grp_vis         = "4. Hiển thị & Đồ họa Biểu đồ"
showSidewayBox  = input.bool(true, "Vẽ hình chữ nhật (Box) bao quanh nến Sideway", group = grp_vis, tooltip = "Vẽ khung chữ nhật động bao bọc toàn bộ cụm nến (đỉnh cao nhất - đáy thấp nhất) trong suốt giai đoạn Sideway Up/Down.")
showTradeLevels = input.bool(true, "Vẽ các đường Entry, SL, TP1, TP2 trên biểu đồ", group = grp_vis)
vmaShowTrend    = input.bool(false, "Show VMA Trend Direction", group = grp_vis, tooltip = "Đổi màu đường VMA theo xu hướng tăng (Green) / giảm (Red) / đi ngang (Blue)")

// --- Group 5: Bảng Thống kê Dashboard ---
grp_tbl         = "5. Bảng Thống kê Dashboard"
showTable       = input.bool(true, "Hiển thị Bảng Dashboard Thống kê", group = grp_tbl)
tablePos        = input.string("Bottom Right", "Vị trí Bảng", options = ["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group = grp_tbl)
tableSize       = input.string("Small", "Cỡ chữ Dashboard", options = ["Tiny", "Small", "Normal", "Large"], group = grp_tbl)


// ==============================================================================
// 1.4. CƠ CHẾ NẠP CẤU HÌNH THEO TEMPLATE (PRESET OVERRIDES)
// ==============================================================================
bool isPresetST   = templateChoice == "Scalp using Supertrend"
bool isPresetVWAP = templateChoice == "Scalp using VWAP"
bool isPresetVCP  = templateChoice == "VCP"

// Các biến hiệu dụng (Effective Parameters)
bool   effIsAdaptive        = isPresetST ? true : (isPresetVWAP ? false : isAdaptive)
string effStTrendType       = isPresetST ? "Follow Trend" : (isPresetVWAP ? "Follow Trend" : (isPresetVCP ? "Follow Trend" : stTrendType))
bool   effUseVwapFilter     = isPresetST ? false : (isPresetVWAP ? true : (isPresetVCP ? false : useVwapFilter))
string effVwapAnchor        = isPresetVWAP ? "Day" : vwapAnchor
string effVwapTrendType     = isPresetVWAP ? "Follow Trend" : vwapTrendType
string effMustInMiddle      = isPresetVWAP ? "In Middle" : mustInMiddle
string effSpreadFilterType  = spreadFilterType
int    effSpreadLookback    = spreadLookback

string effSidewayMethod = isPresetVCP ? "VCP" : sidewayMethod
string effEntryType     = isPresetST ? "Supertrend Flip" : (isPresetVWAP ? "Breakdown" : (isPresetVCP ? "Break Sideway" : entryType))
string effSlType        = isPresetST ? "Supertrend" : (isPresetVWAP ? "Entry Candle" : (isPresetVCP ? "Sideway Zone" : slType))
string effTpType        = isPresetST ? "ATR" : (isPresetVWAP ? "VWAP" : tpType)
string effTp1Mode       = isPresetST ? "Theo RRR / Tỷ lệ" : (isPresetVWAP ? "Theo RRR / Tỷ lệ" : tp1Mode)
string effTp2Mode       = isPresetST ? "Theo RRR / Tỷ lệ" : (isPresetVWAP ? "Theo RRR / Tỷ lệ" : tp2Mode)
float  effRrrTp1        = isPresetST ? 1.5 : (isPresetVWAP ? 1.0 : rrrTp1)
float  effRrrTp2        = isPresetST ? 3.0 : (isPresetVWAP ? 2.0 : rrrTp2)
string effMoveSlToBe    = isPresetST ? "TP 1" : (isPresetVWAP ? "TP 1" : (isPresetVCP ? "TP 1" : moveSlToBe))
string effClosePosMode  = isPresetST ? "Supertrend đảo ngược chiều" : (isPresetVWAP ? "Chạm VWAP" : (isPresetVCP ? "None" : closePosMode))
bool   effFilterSideway = isPresetST ? false : (isPresetVWAP ? false : (isPresetVCP ? false : filterSideway))


// ==============================================================================
// 2. TÍNH TOÁN CƠ CHẾ THÍCH ỨNG (ADAPTIVE ENGINE)
// ==============================================================================

// 2.1. Kaufman Efficiency Ratio (KER): Đo lường độ mượt / hiệu quả xu hướng
calcKER(int len) =>
    float change     = math.abs(close - close[len])
    float volatility = math.sum(math.abs(close - close[1]), len)
    volatility != 0.0 ? change / volatility : 0.0

float ker = calcKER(14) // 1.0 = xu hướng rất mượt, 0.0 = sideway hỗn loạn hoàn toàn

// 2.2. Normalized Volatility Rank: Đo lường mức biến động tương đối
float baseAtr = ta.atr(14)
float volRank = ta.percentrank(baseAtr, 50) / 100.0 // [0.0, 1.0]

// 2.3. Tính toán Period & Factor thích ứng
// - Khi KER cao (Trend mượt): Period -> minPeriod (5), Factor -> minFactor (2.0) để phản ứng nhanh và bám sát giá.
// - Khi KER thấp (Chop/Sideway): Period -> maxPeriod (20), Factor -> maxFactor (5.0) để tránh bị bẫy nhiễu (whipsaw).
float calcAdaptPeriod = minPeriod + (1.0 - ker) * (maxPeriod - minPeriod)
int   adaptivePeriod   = int(math.round(math.max(minPeriod, math.min(maxPeriod, calcAdaptPeriod))))

float calcAdaptFactor = minFactor + (0.5 * (1.0 - ker) + 0.5 * volRank) * (maxFactor - minFactor)
float adaptiveFactor   = math.max(minFactor, math.min(maxFactor, calcAdaptFactor))

// 2.4. Lựa chọn thông số hiệu dụng
float effectivePeriod = effIsAdaptive ? float(adaptivePeriod) : float(fixedPeriod)
float effectiveFactor = effIsAdaptive ? float(adaptiveFactor) : float(fixedFactor)


// ==============================================================================
// 3. TÍNH TOÁN SUPERTREND (HỖ TRỢ THAM SỐ ĐỘNG SERIES INT / FLOAT)
// ==============================================================================

// Hàm tính ATR động với chu kỳ biến thiên (Series float) theo đúng công thức Wilder's RMA của TradingView
calcDynamicAtr(series float period) =>
    float trVal = ta.tr(true)
    float alpha = 1.0 / math.max(1.0, period)
    var float dynamicAtr = na
    dynamicAtr := na(dynamicAtr[1]) ? trVal : (alpha * trVal + (1.0 - alpha) * nz(dynamicAtr[1], trVal))
    dynamicAtr

// Tính ATR động tại phạm vi toàn cục mỗi nến (Global Series)
float globalAtr = calcDynamicAtr(effectivePeriod)

calcSupertrend(series float factor, series float atrVal) =>
    float src       = hl2
    float upperBand = src + factor * atrVal
    float lowerBand = src - factor * atrVal
    
    var float prevLowerBand = 0.0
    var float prevUpperBand = 0.0
    var int   direction     = 1
    
    prevLowerBand := nz(lowerBand[1])
    prevUpperBand := nz(upperBand[1])
    
    lowerBand := (lowerBand > prevLowerBand or close[1] < prevLowerBand) ? lowerBand : prevLowerBand
    upperBand := (upperBand < prevUpperBand or close[1] > prevUpperBand) ? upperBand : prevUpperBand
    
    if na(close[1])
        direction := 1
    else if direction[1] == 1
        direction := close < prevLowerBand ? -1 : 1
    else
        direction := close > prevUpperBand ? 1 : -1
        
    float stValue = direction == 1 ? lowerBand : upperBand
    [stValue, direction]

[supertrendVal, supertrendDir] = calcSupertrend(effectiveFactor, globalAtr)

// Nhận diện Đảo chiều Supertrend (Change Direction)
bool isSupertrendBuy  = (supertrendDir == 1) and (supertrendDir[1] == -1 or na(supertrendDir[1]))
bool isSupertrendSell = (supertrendDir == -1) and (supertrendDir[1] == 1 or na(supertrendDir[1]))

// Lưu lại giá trị Supertrend của sóng trước để xác định trạng thái Sideway / Strong Trend của Supertrend
var float lastStDownVal = na
var float lastStUpVal   = na

if isSupertrendBuy
    lastStDownVal := nz(supertrendVal[1])

if isSupertrendSell
    lastStUpVal   := nz(supertrendVal[1])

// --- BIẾN TOÀN CỤC: TRẠNG THÁI THỊ TRƯỜNG (GLOBAL MARKET STATE) ---
// - Tăng: Supertrend Up
// - Giảm: Supertrend Down
// - Tăng mạnh: Supertrend Up và Supertrend sóng tăng > Supertrend sóng giảm trước đó
// - Giảm mạnh: Supertrend Down và Supertrend sóng giảm < Supertrend sóng tăng trước đó
bool isStrongTrendUp   = (supertrendDir == 1) and (not na(lastStDownVal) and supertrendVal > lastStDownVal)
bool isStrongTrendDown = (supertrendDir == -1) and (not na(lastStUpVal) and supertrendVal < lastStUpVal)

string marketState = isStrongTrendUp   ? "Tăng mạnh" :
                     supertrendDir == 1 ? "Tăng" :
                     isStrongTrendDown ? "Giảm mạnh" : "Giảm"

// --- Supertrend Cloud / Body Fill ---
bodyMiddle = plot(barstate.isfirst ? na : (open + close) / 2, "Body Middle", display = display.none)
upTrend    = plot(supertrendDir == 1 ? supertrendVal : na, "Supertrend Uptrend", color = color.new(#00e676, 0), linewidth = 1, style = plot.style_linebr)
downTrend  = plot(supertrendDir == -1 ? supertrendVal : na, "Supertrend Downtrend", color = color.new(#ff1744, 0), linewidth = 1, style = plot.style_linebr)

fill(bodyMiddle, upTrend,   title = "Uptrend Background Cloud",   color = color.new(#00e676, 90), fillgaps = false)
fill(bodyMiddle, downTrend, title = "Downtrend Background Cloud", color = color.new(#ff1744, 90), fillgaps = false)

// --- 3.2. Tính toán Anchored VWAP & 3 Dải Upper / Lower ---
calcAnchorVwap(string anchor) =>
    string tf = anchor == "Year" ? "12M" : anchor == "Quarter" ? "3M" : anchor == "Month" ? "M" : anchor == "Week" ? "W" : "D"
    bool isNewPeriod = ta.change(time(tf)) != 0
    var float sumSrcVol    = 0.0
    var float sumVol       = 0.0
    var float sumSrcSrcVol = 0.0
    if isNewPeriod or barstate.isfirst
        sumSrcVol    := hlc3 * nz(volume, 1.0)
        sumVol       := nz(volume, 1.0)
        sumSrcSrcVol := hlc3 * hlc3 * nz(volume, 1.0)
    else
        sumSrcVol    += hlc3 * nz(volume, 1.0)
        sumVol       += nz(volume, 1.0)
        sumSrcSrcVol += hlc3 * hlc3 * nz(volume, 1.0)
    float vwap = sumVol != 0.0 ? sumSrcVol / sumVol : hlc3
    float variance = sumVol != 0.0 ? math.max(0.0, (sumSrcSrcVol / sumVol) - (vwap * vwap)) : 0.0
    float vwapStdev = math.sqrt(variance)
    [vwap, vwapStdev]

[vwapValue, vwapStdev] = calcAnchorVwap(effVwapAnchor)

// 3 Dải Upper và 3 Dải Lower của VWAP:
// - Dải 1: Tỷ lệ cố định 1.0 x StDev
// - Dải 2: Tỷ lệ theo TP1 (effRrrTp1)
// - Dải 3: Tỷ lệ theo TP2 (effRrrTp2)
float vwapUpper1 = vwapValue + 1.0 * vwapStdev
float vwapLower1 = vwapValue - 1.0 * vwapStdev

float vwapUpper2 = vwapValue + effRrrTp1 * vwapStdev
float vwapLower2 = vwapValue - effRrrTp1 * vwapStdev

float vwapUpper3 = vwapValue + effRrrTp2 * vwapStdev
float vwapLower3 = vwapValue - effRrrTp2 * vwapStdev

// Vẽ đường Anchored VWAP và các dải biên
plot(effUseVwapFilter and showVwapLine ? vwapValue : na, "Anchored VWAP", color = color.new(#ffffff, 0), linewidth = 2, style = plot.style_line)
plot(effUseVwapFilter and showVwapBands ? vwapUpper1 : na, "VWAP Upper 1 (1.0x)", color = color.new(#38bdf8, 30), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dotted)
plot(effUseVwapFilter and showVwapBands ? vwapLower1 : na, "VWAP Lower 1 (1.0x)", color = color.new(#38bdf8, 30), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dotted)
plot(effUseVwapFilter and showVwapBands ? vwapUpper2 : na, "VWAP Upper 2 (TP1)", color = color.new(#a855f7, 20), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dashed)
plot(effUseVwapFilter and showVwapBands ? vwapLower2 : na, "VWAP Lower 2 (TP1)", color = color.new(#a855f7, 20), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dashed)
plot(effUseVwapFilter and showVwapBands ? vwapUpper3 : na, "VWAP Upper 3 (TP2)", color = color.new(#f43f5e, 10), linewidth = 2, style = plot.style_line, linestyle = plot.linestyle_dashed)
plot(effUseVwapFilter and showVwapBands ? vwapLower3 : na, "VWAP Lower 3 (TP2)", color = color.new(#10b981, 10), linewidth = 2, style = plot.style_line, linestyle = plot.linestyle_dashed)

// --- 3.3. Tính toán ATR(6) Khung Thời Gian Lớn (HTF ATR) ---
getHtfResolution(string tf) =>
    tf == "M5"  ? "5"   : tf == "M30" ? "30"  : tf == "H4"  ? "240" : tf == "D1"  ? "D"   : tf == "W1"  ? "W"   : "D"

string htfRes = getHtfResolution(htfTf)
float  atrHtf = request.security(syminfo.tickerid, htfRes, ta.atr(6))

// ==============================================================================
// 4. NHẬN DIỆN TRẠNG THÁI SIDEWAY (SIDEWAY UP & SIDEWAY DOWN)
// ==============================================================================

// 4.1. Chỉ báo ADX
[diPlus, diMinus, adxValue] = ta.dmi(14, 14)

// 4.2. Chỉ báo Choppiness Index (CHOP)
calcCHOP(int len) =>
    float sumAtr    = math.sum(ta.tr, len)
    float maxHigh   = ta.highest(high, len)
    float minLow    = ta.lowest(low, len)
    float rangeDiff = maxHigh - minLow
    rangeDiff > 0.0 and sumAtr > 0.0 ? 100.0 * math.log10(sumAtr / rangeDiff) / math.log10(len) : 50.0

float chopValue = calcCHOP(14)

// 4.3. Bollinger Bands Squeeze
float bbBasis = ta.sma(close, 20)
float bbDev   = 2.0 * ta.stdev(close, 20)
float bbWidth = bbBasis != 0 ? ((bbBasis + bbDev) - (bbBasis - bbDev)) / bbBasis * 100.0 : 0.0
bool  bbSqueeze = bbWidth < ta.sma(bbWidth, 50)

// 4.3.1. Variable Moving Average (VMA) & ATR Bands (ubx, lbx) phục vụ mô hình VCP
calc_vma(float src, int l) => 
    float k = 1.0 / l
    float pdm = math.max(src - nz(src[1], src), 0.0)
    float mdm = math.max(nz(src[1], src) - src, 0.0)
    var float pdmS = 0.0
    pdmS := (1.0 - k) * nz(pdmS[1]) + k * pdm
    var float mdmS = 0.0
    mdmS := (1.0 - k) * nz(mdmS[1]) + k * mdm
    float s = pdmS + mdmS
    float pdi = s != 0.0 ? pdmS / s : 0.0
    float mdi = s != 0.0 ? mdmS / s : 0.0
    var float pdiS = 0.0
    pdiS := (1.0 - k) * nz(pdiS[1]) + k * pdi
    var float mdiS = 0.0
    mdiS := (1.0 - k) * nz(mdiS[1]) + k * mdi
    float d = math.abs(pdiS - mdiS)
    float s1 = pdiS + mdiS
    var float iS = 0.0
    iS := (1.0 - k) * nz(iS[1]) + k * (s1 != 0.0 ? d / s1 : 0.0)
    float hhv = ta.highest(iS, l) 
    float llv = ta.lowest(iS, l) 
    float d1 = hhv - llv
    float vI = d1 != 0.0 ? (iS - llv) / d1 : 0.0
    var float vma = 0.0
    vma := (1.0 - k * vI) * nz(vma[1], src) + k * vI * src
    vma

float vma   = calc_vma(close, vmaLen)
float o     = vmaMult * ta.atr(vmaLen)
float uband = vma + o
float lband = vma - o
color vmaC  = (vma > nz(vma[1], vma)) ? color.green : (vma < nz(vma[1], vma)) ? color.red : (vma == nz(vma[1], vma)) ? color.blue : color.black

// Vẽ VMA và VMA Bands (ubx, lbx) trên biểu đồ khi chọn phương pháp VCP hoặc Entry Type là VMA Reversal
pVma = plot(effSidewayMethod == "VCP" or effEntryType == "VMA Reversal" ? vma : na, "VMA", color = vmaShowTrend ? vmaC : color.new(#fbbf24, 20), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_solid)
ubx  = plot(effSidewayMethod == "VCP" or effEntryType == "VMA Reversal" ? uband : na, "VMA UpperBand (ubx)", color = color.new(#38bdf8, 30), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dotted)
lbx  = plot(effSidewayMethod == "VCP" or effEntryType == "VMA Reversal" ? lband : na, "VMA LowerBand (lbx)", color = color.new(#38bdf8, 30), linewidth = 1, style = plot.style_line, linestyle = plot.linestyle_dotted)

// 4.4. Cơ chế Nhận diện Sideway theo cấu trúc NARROW SIDEWAY (Price Action & FVG)

// --- A. Dữ liệu Đỉnh/Đáy và FVG trong sóng Tăng (Supertrend Up) ---
var float peakHighInUp = na
var float peakLowInUp  = na

if isSupertrendBuy
    peakHighInUp := high
    peakLowInUp  := low
else if supertrendDir == 1
    if na(peakHighInUp) or high > peakHighInUp
        peakHighInUp := high
        peakLowInUp  := low

// FVG Giảm (Bearish FVG) trong sóng Tăng: Nến [1] đỏ, có khoảng cách giữa Low[2] và High[0]
bool isBearishFvg = (close[1] < open[1]) and (low[2] > high)
var float lastBearFvgBottom = na

// --- B. Dữ liệu Đỉnh/Đáy và FVG trong sóng Giảm (Supertrend Down) ---
var float valleyLowInDown  = na
var float valleyHighInDown = na

if isSupertrendSell
    valleyLowInDown  := low
    valleyHighInDown := high
else if supertrendDir == -1
    if na(valleyLowInDown) or low < valleyLowInDown
        valleyLowInDown  := low
        valleyHighInDown := high

// FVG Tăng (Bullish FVG) trong sóng Giảm: Nến [1] xanh, có khoảng cách giữa High[2] và Low[0]
bool isBullishFvg = (close[1] > open[1]) and (high[2] < low)
var float lastBullFvgTop = na

// --- C. Theo dõi trạng thái NARROW SIDEWAY UP ---
var bool  inNarrowUp        = false
var int   narrowStartBarUp  = na
var int   narrowUpBullCt    = 0
var int   narrowUpBearCt    = 0
var float narrowHighUp      = na
var float narrowLowUp       = na
var bool  hasFvgInNarrowUp  = false

// Bắt đầu Sideway Up dạng 1 (dưới đáy nến cao nhất trước đó - không có FVG)
bool condPeakBelow = (supertrendDir == 1) and not na(peakLowInUp) and (high < peakLowInUp)

// Điều kiện kết thúc Sideway Up
bool condNarrowUpEnd = (close > math.max(high[1], high[2])) or (hasFvgInNarrowUp and not na(lastBearFvgBottom) and close >= lastBearFvgBottom)

if isSupertrendBuy or supertrendDir != 1
    inNarrowUp        := false
    narrowStartBarUp  := na
    narrowUpBullCt    := 0
    narrowUpBearCt    := 0
    narrowHighUp      := na
    narrowLowUp       := na
    lastBearFvgBottom := na
    hasFvgInNarrowUp  := false
else if supertrendDir == 1
    // Nếu xuất hiện FVG giảm mới trong sóng tăng -> Bắt đầu tính lại vùng Sideway theo FVG đó
    if isBearishFvg
        lastBearFvgBottom := high
        inNarrowUp        := true
        hasFvgInNarrowUp  := true
        narrowStartBarUp  := bar_index - 1
        narrowUpBullCt    := (close[1] > open[1] ? 1 : 0) + (close > open ? 1 : 0)
        narrowUpBearCt    := (close[1] < open[1] ? 1 : 0) + (close < open ? 1 : 0)
        narrowHighUp      := math.max(high[1], high)
        narrowLowUp       := math.min(low[1], low)
    else if not inNarrowUp
        if condPeakBelow
            inNarrowUp        := true
            hasFvgInNarrowUp  := false
            narrowStartBarUp  := bar_index
            narrowUpBullCt    := close > open ? 1 : 0
            narrowUpBearCt    := close < open ? 1 : 0
            narrowHighUp      := high
            narrowLowUp       := low
    else
        // Đang trong sideway up
        narrowUpBullCt += (close > open ? 1 : 0)
        narrowUpBearCt += (close < open ? 1 : 0)
        narrowHighUp   := math.max(nz(narrowHighUp, high), high)
        narrowLowUp    := math.min(nz(narrowLowUp, low), low)
        
        if condNarrowUpEnd
            inNarrowUp := false
            if hasFvgInNarrowUp
                lastBearFvgBottom := na
                hasFvgInNarrowUp  := false

bool isNarrowUpActive = inNarrowUp and (narrowUpBullCt + narrowUpBearCt >= 3) and (narrowUpBullCt >= 1 and narrowUpBearCt >= 1)

// --- D. Theo dõi trạng thái NARROW SIDEWAY DOWN ---
var bool  inNarrowDown        = false
var int   narrowStartBarDown  = na
var int   narrowDownBullCt    = 0
var int   narrowDownBearCt    = 0
var float narrowHighDown      = na
var float narrowLowDown       = na
var bool  hasFvgInNarrowDown  = false

// Bắt đầu Sideway Down dạng 1 (trên đỉnh nến thấp nhất trước đó - không có FVG)
bool condValleyAbove = (supertrendDir == -1) and not na(valleyHighInDown) and (low > valleyHighInDown)

// Điều kiện kết thúc Sideway Down
bool condNarrowDownEnd = (close < math.min(low[1], low[2])) or (hasFvgInNarrowDown and not na(lastBullFvgTop) and close <= lastBullFvgTop)

if isSupertrendSell or supertrendDir != -1
    inNarrowDown        := false
    narrowStartBarDown  := na
    narrowDownBullCt    := 0
    narrowDownBearCt    := 0
    narrowHighDown      := na
    narrowLowDown       := na
    lastBullFvgTop      := na
    hasFvgInNarrowDown  := false
else if supertrendDir == -1
    // Nếu xuất hiện FVG tăng mới trong sóng giảm -> Bắt đầu tính lại vùng Sideway theo FVG đó
    if isBullishFvg
        lastBullFvgTop     := low
        inNarrowDown       := true
        hasFvgInNarrowDown := true
        narrowStartBarDown := bar_index - 1
        narrowDownBullCt   := (close[1] > open[1] ? 1 : 0) + (close > open ? 1 : 0)
        narrowDownBearCt   := (close[1] < open[1] ? 1 : 0) + (close < open ? 1 : 0)
        narrowHighDown     := math.max(high[1], high)
        narrowLowDown      := math.min(low[1], low)
    else if not inNarrowDown
        if condValleyAbove
            inNarrowDown       := true
            hasFvgInNarrowDown := false
            narrowStartBarDown := bar_index
            narrowDownBullCt   := close > open ? 1 : 0
            narrowDownBearCt   := close < open ? 1 : 0
            narrowHighDown     := high
            narrowLowDown      := low
    else
        // Đang trong sideway down
        narrowDownBullCt += (close > open ? 1 : 0)
        narrowDownBearCt += (close < open ? 1 : 0)
        narrowHighDown   := math.max(nz(narrowHighDown, high), high)
        narrowLowDown    := math.min(nz(narrowLowDown, low), low)
        
        if condNarrowDownEnd
            inNarrowDown := false
            if hasFvgInNarrowDown
                lastBullFvgTop     := na
                hasFvgInNarrowDown := false

bool isNarrowDownActive = inNarrowDown and (narrowDownBullCt + narrowDownBearCt >= 3) and (narrowDownBullCt >= 1 and narrowDownBearCt >= 1)

// --- E. Theo dõi trạng thái VCP (Volatility Contraction Pattern) ---
// 1. VCP Up trong sóng Tăng (Supertrend Up)
var bool  inVcpZone           = false
var int   vcpStartBar         = na
var int   vcpCandleCount      = 0
var int   vcpHighBelowUpperCt = 0
var float vcpHigh             = na
var float vcpLow              = na
var bool  vcpTriggerLong      = false

var bool  vcpBreakoutEnded    = false
var int   vcpEndBar           = na
var float vcpEndHigh          = na
var float vcpEndLow           = na

vcpTriggerLong   := false
vcpBreakoutEnded := false

if isSupertrendBuy or isSupertrendSell or supertrendDir != 1
    inVcpZone           := false
    vcpStartBar         := na
    vcpCandleCount      := 0
    vcpHighBelowUpperCt := 0
    vcpHigh             := na
    vcpLow              := na
else if supertrendDir == 1
    // Điều kiện VCP Up:
    // - Open phải nằm trong dải Bands (lband <= open <= uband)
    // - Không có Low nào của nến < Lower Band (low >= lband)
    // - Close >= lband
    if (open < lband or open > uband) or (low < lband) or (close < lband)
        // Vi phạm điều kiện: Open nằm ngoài Bands hoặc Low phá vỡ Lower Band -> Reset vùng VCP Up
        inVcpZone           := false
        vcpStartBar         := na
        vcpCandleCount      := 0
        vcpHighBelowUpperCt := 0
        vcpHigh             := na
        vcpLow              := na
    else
        // Open nằm trong Bands, Low >= lband, Close >= lband (thỏa mãn điều kiện)
        // Điều kiện 3: Kết thúc vùng giá khi đóng cửa trên Upperband (uband / ubx)
        if close > uband
            if inVcpZone
                // Tối thiểu 3 nến trước nến breakout và Điều kiện 2 (ít nhất 2 nến high < Upper band)
                if (vcpCandleCount >= 3) and (vcpHighBelowUpperCt >= 2)
                    vcpTriggerLong   := true
                    vcpBreakoutEnded := true
                    vcpEndBar        := bar_index
                    vcpEndHigh       := vcpHigh
                    vcpEndLow        := vcpLow
                
                // Kết thúc vùng VCP sau khi breakout
                inVcpZone           := false
                vcpStartBar         := na
                vcpCandleCount      := 0
                vcpHighBelowUpperCt := 0
                vcpHigh             := na
                vcpLow              := na
        else
            // Nến nằm trong khoảng [Lowerband, Upperband] (lband <= close <= uband)
            if not inVcpZone
                // Bắt đầu vùng VCP mới
                inVcpZone           := true
                vcpStartBar         := bar_index
                vcpCandleCount      := 1
                vcpHighBelowUpperCt := (high < uband ? 1 : 0)
                vcpHigh             := high
                vcpLow              := low
            else
                // Tiếp tục tích lũy trong vùng VCP
                vcpCandleCount += 1
                if high < uband
                    vcpHighBelowUpperCt += 1
                vcpHigh := math.max(nz(vcpHigh, high), high)
                vcpLow  := math.min(nz(vcpLow, low), low)

bool isVcpUpActive = inVcpZone and (vcpCandleCount >= 3) and (vcpHighBelowUpperCt >= 2)

// 2. VCP Down trong sóng Giảm (Supertrend Down)
var bool  inVcpDownZone        = false
var int   vcpStartBarDown      = na
var int   vcpCandleCountDown   = 0
var int   vcpLowAboveLowerCt   = 0
var float vcpHighDown          = na
var float vcpLowDown           = na
var bool  vcpTriggerShort      = false

var bool  vcpBreakoutEndedDown = false
var int   vcpEndBarDown        = na
var float vcpEndHighDown       = na
var float vcpEndLowDown        = na

vcpTriggerShort      := false
vcpBreakoutEndedDown := false

if isSupertrendBuy or isSupertrendSell or supertrendDir != -1
    inVcpDownZone      := false
    vcpStartBarDown    := na
    vcpCandleCountDown := 0
    vcpLowAboveLowerCt := 0
    vcpHighDown        := na
    vcpLowDown         := na
else if supertrendDir == -1
    // Điều kiện VCP Down:
    // - Open phải nằm trong dải Bands (lband <= open <= uband)
    // - Không có High nào của nến > Upper Band (high <= uband)
    // - Close <= uband
    if (open < lband or open > uband) or (high > uband) or (close > uband)
        // Vi phạm điều kiện: Open nằm ngoài Bands hoặc High vượt Upper Band -> Reset vùng VCP Down
        inVcpDownZone      := false
        vcpStartBarDown    := na
        vcpCandleCountDown := 0
        vcpLowAboveLowerCt := 0
        vcpHighDown        := na
        vcpLowDown         := na
    else
        // Open nằm trong Bands, High <= uband, Close <= uband (thỏa mãn điều kiện)
        // Điều kiện 3: Kết thúc vùng giá khi đóng cửa dưới Lowerband (lband / lbx)
        if close < lband
            if inVcpDownZone
                // Tối thiểu 3 nến trước nến breakdown và Điều kiện 2 (ít nhất 2 nến low > Lower band)
                if (vcpCandleCountDown >= 3) and (vcpLowAboveLowerCt >= 2)
                    vcpTriggerShort      := true
                    vcpBreakoutEndedDown := true
                    vcpEndBarDown        := bar_index
                    vcpEndHighDown       := vcpHighDown
                    vcpEndLowDown        := vcpLowDown
                
                // Kết thúc vùng VCP Down sau khi breakdown
                inVcpDownZone      := false
                vcpStartBarDown    := na
                vcpCandleCountDown := 0
                vcpLowAboveLowerCt := 0
                vcpHighDown        := na
                vcpLowDown         := na
        else
            // Nến nằm trong khoảng [Lowerband, Upperband] (lband <= close <= uband)
            if not inVcpDownZone
                // Bắt đầu vùng VCP Down mới
                inVcpDownZone      := true
                vcpStartBarDown    := bar_index
                vcpCandleCountDown := 1
                vcpLowAboveLowerCt := (low > lband ? 1 : 0)
                vcpHighDown        := high
                vcpLowDown         := low
            else
                // Tiếp tục tích lũy trong vùng VCP Down
                vcpCandleCountDown += 1
                if low > lband
                    vcpLowAboveLowerCt += 1
                vcpHighDown := math.max(nz(vcpHighDown, high), high)
                vcpLowDown  := math.min(nz(vcpLowDown, low), low)

bool isVcpDownActive = inVcpDownZone and (vcpCandleCountDown >= 3) and (vcpLowAboveLowerCt >= 2)

// 4.5. Đánh giá điều kiện Sideway theo Phương pháp được chọn
bool isSidewayRaw = false

if effSidewayMethod == "Narrow Sideway"
    isSidewayRaw := isNarrowUpActive or isNarrowDownActive
else if effSidewayMethod == "VCP"
    isSidewayRaw := isVcpUpActive or isVcpDownActive
else if effSidewayMethod == "ADX Thấp"
    isSidewayRaw := adxValue < adxThresh
else if effSidewayMethod == "Choppiness Index Cao"
    isSidewayRaw := chopValue > chopThresh
else if effSidewayMethod == "Kaufman ER Thấp"
    isSidewayRaw := ker < erThresh
else if effSidewayMethod == "Biên độ nén BB Width"
    isSidewayRaw := bbSqueeze
else // "Kết hợp (ADX + Kaufman ER + CHOP)"
    isSidewayRaw := (adxValue < adxThresh or chopValue > chopThresh) and (ker < erThresh or bbSqueeze)

// Phân loại trạng thái:
bool isSidewayUp   = detectSideway and (supertrendDir == 1) and (effSidewayMethod == "Narrow Sideway" ? isNarrowUpActive : (effSidewayMethod == "VCP" ? isVcpUpActive : isSidewayRaw))
bool isSidewayDown = detectSideway and (supertrendDir == -1) and (effSidewayMethod == "Narrow Sideway" ? isNarrowDownActive : (effSidewayMethod == "VCP" ? isVcpDownActive : isSidewayRaw))
bool isTrendingUp  = (supertrendDir == 1) and not isSidewayUp
bool isTrendingDown = (supertrendDir == -1) and not isSidewayDown

// 4.6. THEO DÕI VÙNG FIRST PULLBACK (THEO SÓNG SUPERTREND)
var int   revBarIdxUp        = na
var bool  inFirstPbUp        = false
var bool  hadFirstPbUp       = false
var int   pbStartBarUp       = na
var float pbHighUp           = na
var float pbLowUp            = na
var box   pbBoxUp            = na
var bool  pbLongTrigger      = false

var int   revBarIdxDown      = na
var bool  inFirstPbDown      = false
var bool  hadFirstPbDown     = false
var int   pbStartBarDown     = na
var float pbHighDown         = na
var float pbLowDown          = na
var box   pbBoxDown          = na
var bool  pbShortTrigger     = false

pbLongTrigger  := false
pbShortTrigger := false

// --- A. First Pullback trong Sóng Tăng (Supertrend Up) ---
if isSupertrendBuy
    revBarIdxUp   := bar_index
    inFirstPbUp   := false
    hadFirstPbUp  := false
    pbStartBarUp  := na
    pbHighUp      := na
    pbLowUp       := na
    pbBoxUp       := na
else if supertrendDir == 1 and not hadFirstPbUp
    int barsSinceRevUp = bar_index - nz(revBarIdxUp, bar_index)
    int atrWindowUp    = int(math.round(effectivePeriod))
    
    if not inFirstPbUp
        // Bắt đầu khi phá qua đáy 3 nến trước đó và còn trong khoảng ATR Period từ nến Reversal
        bool condStartPbUp = (bar_index >= 3) and (low < math.min(low[1], math.min(low[2], low[3]))) and (barsSinceRevUp <= atrWindowUp)
        if condStartPbUp
            inFirstPbUp  := true
            pbStartBarUp := bar_index
            pbHighUp     := high
            pbLowUp      := low
            if showSidewayBox and allowLong
                pbBoxUp := box.new(
                     left         = bar_index,
                     top          = high,
                     right        = bar_index,
                     bottom       = low,
                     border_color = color.new(#3b82f6, 0),
                     border_width = 1,
                     border_style = line.style_solid,
                     bgcolor      = color.new(#3b82f6, 88),
                     text         = "First Pullback Up",
                     text_size    = size.tiny,
                     text_color   = color.new(#1d4ed8, 0),
                     text_valign  = text.align_top,
                     text_halign  = text.align_left
                )
    else
        // Đang trong vùng First Pullback Up: cập nhật đỉnh, đáy và mở rộng box
        pbHighUp := math.max(nz(pbHighUp, high), high)
        pbLowUp  := math.min(nz(pbLowUp, low), low)
        if not na(pbBoxUp)
            box.set_right(pbBoxUp, bar_index)
            box.set_top(pbBoxUp, pbHighUp)
            box.set_bottom(pbBoxUp, pbLowUp)
            
        // Điều kiện kết thúc: có nến phá đỉnh 2 nến trước HOẶC đạt cây nến thứ ATR Period tính từ Reversal
        bool condEndPbUp = (bar_index >= 2 and close > math.max(high[1], high[2])) or (barsSinceRevUp >= atrWindowUp)
        if condEndPbUp
            inFirstPbUp   := false
            hadFirstPbUp  := true
            // Entry sau khi vùng kết thúc nếu giá vẫn nằm trên Supertrend
            if close > supertrendVal
                pbLongTrigger := true

    // Hết thời gian chờ tạo Pullback mà chưa xuất hiện
    if not inFirstPbUp and (barsSinceRevUp >= atrWindowUp)
        hadFirstPbUp := true

// --- B. First Pullback trong Sóng Giảm (Supertrend Down) ---
if isSupertrendSell
    revBarIdxDown   := bar_index
    inFirstPbDown   := false
    hadFirstPbDown  := false
    pbStartBarDown  := na
    pbHighDown      := na
    pbLowDown       := na
    pbBoxDown       := na
else if supertrendDir == -1 and not hadFirstPbDown
    int barsSinceRevDown = bar_index - nz(revBarIdxDown, bar_index)
    int atrWindowDown    = int(math.round(effectivePeriod))
    
    if not inFirstPbDown
        // Bắt đầu khi phá qua đỉnh 3 nến trước đó và còn trong khoảng ATR Period từ nến Reversal
        bool condStartPbDown = (bar_index >= 3) and (high > math.max(high[1], math.max(high[2], high[3]))) and (barsSinceRevDown <= atrWindowDown)
        if condStartPbDown
            inFirstPbDown  := true
            pbStartBarDown := bar_index
            pbHighDown     := high
            pbLowDown      := low
            if showSidewayBox and allowShort
                pbBoxDown := box.new(
                     left         = bar_index,
                     top          = high,
                     right        = bar_index,
                     bottom       = low,
                     border_color = color.new(#3b82f6, 0),
                     border_width = 1,
                     border_style = line.style_solid,
                     bgcolor      = color.new(#3b82f6, 88),
                     text         = "First Pullback Down",
                     text_size    = size.tiny,
                     text_color   = color.new(#1d4ed8, 0),
                     text_valign  = text.align_top,
                     text_halign  = text.align_left
                )
    else
        // Đang trong vùng First Pullback Down: cập nhật đỉnh, đáy và mở rộng box
        pbHighDown := math.max(nz(pbHighDown, high), high)
        pbLowDown  := math.min(nz(pbLowDown, low), low)
        if not na(pbBoxDown)
            box.set_right(pbBoxDown, bar_index)
            box.set_top(pbBoxDown, pbHighDown)
            box.set_bottom(pbBoxDown, pbLowDown)
            
        // Điều kiện kết thúc: có nến phá đáy 2 nến trước HOẶC đạt cây nến thứ ATR Period tính từ Reversal
        bool condEndPbDown = (bar_index >= 2 and close < math.min(low[1], low[2])) or (barsSinceRevDown >= atrWindowDown)
        if condEndPbDown
            inFirstPbDown   := false
            hadFirstPbDown  := true
            // Entry sau khi vùng kết thúc nếu giá vẫn nằm dưới Supertrend
            if close < supertrendVal
                pbShortTrigger := true

    // Hết thời gian chờ tạo Pullback mà chưa xuất hiện
    if not inFirstPbDown and (barsSinceRevDown >= atrWindowDown)
        hadFirstPbDown := true

// 4.7. THEO DÕI TÍN HIỆU VMA REVERSAL
// --- A. Nhận diện Signal Bar ---
// Signal Bar Long: Open < VMA và Close > VMA, trong vmaLen nến trước đó có ít nhất 1 nến có Low < lband
bool hadLowBelowLband = false
for i = 1 to vmaLen
    if low[i] < lband[i]
        hadLowBelowLband := true
        break

bool isVmaLongSignalBar = (supertrendDir == 1) and (open < vma) and (close > vma) and hadLowBelowLband

// Signal Bar Short: Supertrend đang Giảm (-1), Open > VMA và Close < VMA, trong vmaLen nến trước đó có ít nhất 1 nến có High > uband
bool hadHighAboveUband = false
for i = 1 to vmaLen
    if high[i] > uband[i]
        hadHighAboveUband := true
        break

bool isVmaShortSignalBar = (supertrendDir == -1) and (open > vma) and (close < vma) and hadHighAboveUband

// --- B. Theo dõi trạng thái chờ Entry Bar ---
var bool  hasPendingVmaLong   = false
var float vmaLongSignalHigh   = na
var float vmaLongSignalLow    = na
var int   vmaLongSignalBar    = na

var bool  hasPendingVmaShort  = false
var float vmaShortSignalHigh  = na
var float vmaShortSignalLow   = na
var int   vmaShortSignalBar   = na

// Cập nhật khi có Signal Bar mới
if isVmaLongSignalBar
    hasPendingVmaLong  := true
    vmaLongSignalHigh  := high
    vmaLongSignalLow   := low
    vmaLongSignalBar   := bar_index

if isVmaShortSignalBar
    hasPendingVmaShort := true
    vmaShortSignalHigh := high
    vmaShortSignalLow  := low
    vmaShortSignalBar  := bar_index

// Điều kiện kích hoạt Entry Bar
bool isVmaReversalLong  = false
bool isVmaReversalShort = false

// - Long Entry: Khi nến hiện tại có close > High của Signal Bar (sau nến Signal Bar)
if hasPendingVmaLong and not na(vmaLongSignalBar) and bar_index > vmaLongSignalBar
    if close > vmaLongSignalHigh
        isVmaReversalLong := true
        hasPendingVmaLong := false
    else if (close < vmaLongSignalLow) or (bar_index - vmaLongSignalBar > vmaLen)
        hasPendingVmaLong := false

// - Short Entry: Khi nến hiện tại có close < Low của Signal Bar (sau nến Signal Bar)
if hasPendingVmaShort and not na(vmaShortSignalBar) and bar_index > vmaShortSignalBar
    if close < vmaShortSignalLow
        isVmaReversalShort := true
        hasPendingVmaShort := false
    else if (close > vmaShortSignalHigh) or (bar_index - vmaShortSignalBar > vmaLen)
        hasPendingVmaShort := false

// Reset trạng thái chờ khi Supertrend đảo chiều
if isSupertrendBuy
    hasPendingVmaShort := false
if isSupertrendSell
    hasPendingVmaLong  := false

// Vẽ biểu tượng Signal Bar cho VMA Reversal (Chỉ hiển thị khi thuận chiều Supertrend và bật allowLong / allowShort)
plotshape(effEntryType == "VMA Reversal" and allowLong and isVmaLongSignalBar, title = "VMA Long Signal Bar", style = shape.triangleup, location = location.belowbar, color = color.new(#10b981, 20), size = size.tiny, text = "Signal", textcolor = color.new(#10b981, 0))
plotshape(effEntryType == "VMA Reversal" and allowShort and isVmaShortSignalBar, title = "VMA Short Signal Bar", style = shape.triangledown, location = location.abovebar, color = color.new(#ef4444, 20), size = size.tiny, text = "Signal", textcolor = color.new(#ef4444, 0))


// ==============================================================================
// 4.8. TÍNH TOÁN CHU KỲ WALK-FORWARD ANALYSIS (WFA ENGINE)
// ==============================================================================

// Ánh xạ chu kỳ WFA sang chuỗi timeframe tương ứng của Pine Script
string wfaTfString = wfaTf == "M5" ? "5" :
                     wfaTf == "M15" ? "15" :
                     wfaTf == "M30" ? "30" :
                     wfaTf == "H1" ? "60" :
                     wfaTf == "H4" ? "240" :
                     wfaTf == "D1" ? "D" :
                     wfaTf == "W1" ? "W" : "M"

int wfaTimeOpen  = time(wfaTfString)
int wfaTimeClose = time_close(wfaTfString)

bool isNewWfaCycle = ta.change(wfaTimeOpen) != 0

var int wfaCycleIndex = 0
if isNewWfaCycle
    wfaCycleIndex += 1

// Tính số thứ tự chu kỳ hiệu dụng có tính đến dịch chuyển Offset
int effCycleIndex          = wfaCycleIndex + wfaCycleOffset
int targetCycleWithOffset  = wfaTargetCycle + wfaCycleOffset

// Xác định chu kỳ hiện tại có nằm trong phạm vi kiểm định (Scope) hay không
bool isCycleInScope = true
if wfaScope == "Chỉ 1 chu kỳ mục tiêu (Single Cycle)"
    isCycleInScope := (wfaCycleIndex == targetCycleWithOffset)
else if wfaScope == "Từ chu kỳ mục tiêu trở đi (From Cycle N)"
    isCycleInScope := (wfaCycleIndex >= targetCycleWithOffset)
else
    isCycleInScope := true

// Tính thời lượng chuẩn của 1 chu kỳ để tính tiến độ
float fallbackDuration = wfaTf == "M5" ? 300000.0 :
                         wfaTf == "M15" ? 900000.0 :
                         wfaTf == "M30" ? 1800000.0 :
                         wfaTf == "H1" ? 3600000.0 :
                         wfaTf == "H4" ? 14400000.0 :
                         wfaTf == "D1" ? 86400000.0 :
                         wfaTf == "W1" ? 604800000.0 : 2592000000.0

float wfaCycleDuration = (not na(wfaTimeClose) and not na(wfaTimeOpen) and wfaTimeClose > wfaTimeOpen) ? float(wfaTimeClose - wfaTimeOpen) : fallbackDuration
float wfaCycleElapsed  = not na(wfaTimeOpen) ? float(time - wfaTimeOpen) : 0.0
float wfaCycleProgress = math.min(1.0, math.max(0.0, wfaCycleDuration > 0 ? wfaCycleElapsed / wfaCycleDuration : 0.0))

// Tỷ lệ phân bổ In-Sample vs Out-of-Sample
float wfaIsRatio = (100.0 - float(wfaOosPercent)) / 100.0

bool isWfaOosTime = wfaCycleProgress >= wfaIsRatio
bool isWfaIsTime  = not isWfaOosTime

bool isWfaOosAlternating = (effCycleIndex % 2 == 0)
bool isWfaIsAlternating  = (effCycleIndex % 2 == 1)

bool isOosActive = false
bool isIsActive  = false

if wfaMode == "Chỉ kiểm định Out-of-Sample (OOS)" or wfaMode == "Chỉ kiểm định In-Sample (IS)" or wfaMode == "Toàn bộ chu kỳ (Cả IS & OOS)"
    isOosActive := isWfaOosTime and isCycleInScope
    isIsActive  := isWfaIsTime and isCycleInScope
else if wfaMode == "Chu kỳ xen kẽ (Xen kẽ 1 chu kỳ IS, 1 chu kỳ OOS)"
    isOosActive := isWfaOosAlternating and isCycleInScope
    isIsActive  := isWfaIsAlternating and isCycleInScope

// Quyết định quyền được mở vị thế mới theo cài đặt WFA
bool wfaTradeAllowed = true
if enableWfa
    if wfaMode == "Chỉ kiểm định Out-of-Sample (OOS)"
        wfaTradeAllowed := isOosActive
    else if wfaMode == "Chỉ kiểm định In-Sample (IS)"
        wfaTradeAllowed := isIsActive
    else if wfaMode == "Chu kỳ xen kẽ (Xen kẽ 1 chu kỳ IS, 1 chu kỳ OOS)"
        wfaTradeAllowed := isOosActive
    else if wfaMode == "Toàn bộ chu kỳ (Cả IS & OOS)"
        wfaTradeAllowed := isCycleInScope


// ==============================================================================
// 5. QUẢN LÝ LỆNH, RRR VÀ THỐNG KÊ (STRATEGY & STATISTICS ENGINE)
// ==============================================================================

// Biến lưu trữ trạng thái vị thế và các mức giá
var float entryPrice   = na
var float slPrice      = na
var float tp1Price     = na
var float tp2Price     = na
var float initialRisk  = na
var int   activeDir    = 0     // 1: Long, -1: Short, 0: Flat
var int   entryBarIdx  = na

var bool  rrr1Reached  = false
var bool  tp1Reached   = false
var bool  tp2Reached   = false
var bool  slReached    = false

// --- THEO DÕI CÁC VÙNG NARROW SIDEWAY TRONG SÓNG SUPERTREND ---
var bool  hasPendingSidewayUp     = false
var float currentSwHighUp         = na
var float currentSwLowUp          = na
var int   lastSidewayEndBarUp     = na

var bool  hasPendingSidewayDown   = false
var float currentSwHighDown       = na
var float currentSwLowDown        = na
var int   lastSidewayEndBarDown   = na

var float lastSidewayHigh         = na
var float lastSidewayLow          = na

// Khi Supertrend đổi chiều -> Bắt đầu sóng mới, reset theo dõi Sideway
if isSupertrendBuy or isSupertrendSell
    hasPendingSidewayUp   := false
    currentSwHighUp       := na
    currentSwLowUp        := na
    lastSidewayEndBarUp   := na
    hasPendingSidewayDown := false
    currentSwHighDown     := na
    currentSwLowDown      := na
    lastSidewayEndBarDown := na
    lastSidewayHigh       := na
    lastSidewayLow        := na

// Trong chu kỳ Supertrend Tăng (supertrendDir == 1)
if supertrendDir == 1
    if effSidewayMethod == "VCP"
        if isSidewayUp
            hasPendingSidewayUp := true
            lastSidewayEndBarUp := na
            currentSwHighUp     := nz(vcpHigh, high)
            currentSwLowUp      := nz(vcpLow, low)
            lastSidewayHigh     := currentSwHighUp
            lastSidewayLow      := currentSwLowUp
        else if vcpTriggerLong
            hasPendingSidewayUp := true
            lastSidewayEndBarUp := bar_index
            currentSwHighUp     := nz(vcpEndHigh, high)
            currentSwLowUp      := nz(vcpEndLow, low)
            lastSidewayHigh     := currentSwHighUp
            lastSidewayLow      := currentSwLowUp
        else
            if isSidewayUp[1] and hasPendingSidewayUp and na(lastSidewayEndBarUp)
                lastSidewayEndBarUp := bar_index
            if not na(lastSidewayEndBarUp) and (bar_index - lastSidewayEndBarUp > 3)
                hasPendingSidewayUp := false
                lastSidewayEndBarUp := na
    else
        if isSidewayUp
            float curHigh = effSidewayMethod == "Narrow Sideway" ? nz(narrowHighUp, high) : high
            float curLow  = effSidewayMethod == "Narrow Sideway" ? nz(narrowLowUp, low) : low
            
            if not isSidewayUp[1]
                hasPendingSidewayUp := true
                lastSidewayEndBarUp := na
                currentSwHighUp     := curHigh
                currentSwLowUp      := curLow
            else
                currentSwHighUp     := math.max(nz(currentSwHighUp, curHigh), curHigh)
                currentSwLowUp      := math.min(nz(currentSwLowUp, curLow), curLow)
                
            lastSidewayHigh := currentSwHighUp
            lastSidewayLow  := currentSwLowUp
        else
            // Vừa thoát khỏi vùng Sideway Up: ghi nhận nến kết thúc
            if isSidewayUp[1] and hasPendingSidewayUp
                lastSidewayEndBarUp := bar_index
                
            // Nếu đã quá 3 nến kể từ khi kết thúc Sideway mà chưa phá vỡ -> Hủy trạng thái chờ Break
            if not na(lastSidewayEndBarUp) and (bar_index - lastSidewayEndBarUp > 3)
                hasPendingSidewayUp := false
                lastSidewayEndBarUp := na

// Trong chu kỳ Supertrend Giảm (supertrendDir == -1)
if supertrendDir == -1
    if effSidewayMethod == "VCP"
        if isSidewayDown
            hasPendingSidewayDown := true
            lastSidewayEndBarDown := na
            currentSwHighDown     := nz(vcpHighDown, high)
            currentSwLowDown      := nz(vcpLowDown, low)
            lastSidewayHigh       := currentSwHighDown
            lastSidewayLow        := currentSwLowDown
        else if vcpTriggerShort
            hasPendingSidewayDown := true
            lastSidewayEndBarDown := bar_index
            currentSwHighDown     := nz(vcpEndHighDown, high)
            currentSwLowDown      := nz(vcpEndLowDown, low)
            lastSidewayHigh       := currentSwHighDown
            lastSidewayLow        := currentSwLowDown
        else
            if isSidewayDown[1] and hasPendingSidewayDown and na(lastSidewayEndBarDown)
                lastSidewayEndBarDown := bar_index
            if not na(lastSidewayEndBarDown) and (bar_index - lastSidewayEndBarDown > 3)
                hasPendingSidewayDown := false
                lastSidewayEndBarDown := na
    else
        if isSidewayDown
            float curHigh = effSidewayMethod == "Narrow Sideway" ? nz(narrowHighDown, high) : high
            float curLow  = effSidewayMethod == "Narrow Sideway" ? nz(narrowLowDown, low) : low
            
            if not isSidewayDown[1]
                hasPendingSidewayDown := true
                lastSidewayEndBarDown := na
                currentSwHighDown     := curHigh
                currentSwLowDown      := curLow
            else
                currentSwHighDown     := math.max(nz(currentSwHighDown, curHigh), curHigh)
                currentSwLowDown      := math.min(nz(currentSwLowDown, curLow), curLow)
                
            lastSidewayHigh := currentSwHighDown
            lastSidewayLow  := currentSwLowDown
        else
            // Vừa thoát khỏi vùng Sideway Down: ghi nhận nến kết thúc
            if isSidewayDown[1] and hasPendingSidewayDown
                lastSidewayEndBarDown := bar_index
                
            // Nếu đã quá 3 nến kể từ khi kết thúc Sideway mà chưa phá vỡ -> Hủy trạng thái chờ Break
            if not na(lastSidewayEndBarDown) and (bar_index - lastSidewayEndBarDown > 3)
                hasPendingSidewayDown := false
                lastSidewayEndBarDown := na

// Biến tích lũy Thống kê (Counters)
var int countTotalTrades = 0
var int countSL          = 0
var int countTP1         = 0
var int countTP2         = 0

// --- ĐIỀU KIỆN VÀO LỆNH (ENTRY CONDITIONS) ---
bool longSignal  = false
bool shortSignal = false

bool isWithin3BarsSwUp   = hasPendingSidewayUp and not isSidewayUp and not na(lastSidewayEndBarUp) and (bar_index - lastSidewayEndBarUp <= 3)
bool isWithin3BarsSwDown = hasPendingSidewayDown and not isSidewayDown and not na(lastSidewayEndBarDown) and (bar_index - lastSidewayEndBarDown <= 3)

bool isBreakSidewayLong  = (supertrendDir == 1) and ((effSidewayMethod == "VCP" and vcpTriggerLong) or (isWithin3BarsSwUp and not na(currentSwHighUp) and (close > currentSwHighUp or ta.crossover(close, currentSwHighUp))))
bool isBreakSidewayShort = (supertrendDir == -1) and ((effSidewayMethod == "VCP" and vcpTriggerShort) or (isWithin3BarsSwDown and not na(currentSwLowDown) and (close < currentSwLowDown or ta.crossunder(close, currentSwLowDown))))
bool isFirstPbLong       = (supertrendDir == 1) and pbLongTrigger
bool isFirstPbShort      = (supertrendDir == -1) and pbShortTrigger

if effEntryType == "Supertrend Flip"
    longSignal  := isSupertrendBuy
    shortSignal := isSupertrendSell
else if effEntryType == "Break Sideway"
    // Long khi đang trong Supertrend tăng, nến hiện tại phá vỡ đỉnh Sideway trong vòng tối đa 3 nến
    longSignal  := isBreakSidewayLong
    // Short khi đang trong Supertrend giảm, nến hiện tại phá vỡ đáy Sideway trong vòng tối đa 3 nến
    shortSignal := isBreakSidewayShort
else if effEntryType == "First Pullback"
    // Long khi vừa kết thúc First Pullback và giá vẫn nằm trên Supertrend
    longSignal  := isFirstPbLong
    // Short khi vừa kết thúc First Pullback và giá vẫn nằm dưới Supertrend
    shortSignal := isFirstPbShort
else if effEntryType == "Pullback + Sideway"
    // Kết hợp: Vào lệnh khi có First Pullback HOẶC khi phá vỡ Break Sideway trong vòng 3 nến
    longSignal  := isFirstPbLong or isBreakSidewayLong
    shortSignal := isFirstPbShort or isBreakSidewayShort
else if effEntryType == "Breakdown"
    // Long: Nến đỏ đóng cửa phá Low nến trước
    longSignal  := (close < open) and (close < low[1])
    // Short: Nến xanh đóng cửa phá High nến trước
    shortSignal := (close > open) and (close > high[1])
else if effEntryType == "VMA Reversal"
    // Long: Signal Bar đảo chiều VMA + Entry Bar Close > High Signal Bar
    longSignal  := isVmaReversalLong
    // Short: Signal Bar đảo chiều VMA + Entry Bar Close < Low Signal Bar
    shortSignal := isVmaReversalShort

// --- Đánh giá bộ lọc Xu hướng Supertrend ---
bool stLongOk  = true
bool stShortOk = true

if effStTrendType == "Follow Trend"
    stLongOk  := close > supertrendVal
    stShortOk := close < supertrendVal
else if effStTrendType == "Counter Trend"
    stLongOk  := close < supertrendVal
    stShortOk := close > supertrendVal
else if effStTrendType == "Swing"
    // Trạng thái Swing của Supertrend:
    // - Long khi đang ở sóng tăng và Supertrend sóng tăng < Supertrend sóng giảm trước đó (Trạng thái "Tăng")
    // - Short khi đang ở sóng giảm và Supertrend sóng giảm > Supertrend sóng tăng trước đó (Trạng thái "Giảm")
    stLongOk  := (close > supertrendVal) and (marketState == "Tăng")
    stShortOk := (close < supertrendVal) and (marketState == "Giảm")
else if effStTrendType == "Strong Trend"
    // Trạng thái Strong Trend của Supertrend:
    // - Long khi đang ở sóng tăng và Supertrend sóng tăng > Supertrend sóng giảm trước đó (Trạng thái "Tăng mạnh")
    // - Short khi đang ở sóng giảm và Supertrend sóng giảm < Supertrend sóng tăng trước đó (Trạng thái "Giảm mạnh")
    stLongOk  := (close > supertrendVal) and (marketState == "Tăng mạnh")
    stShortOk := (close < supertrendVal) and (marketState == "Giảm mạnh")

// --- Đánh giá bộ lọc Xu hướng VWAP Anchor ---
bool vwapLongOk        = true
bool vwapShortOk       = true
bool vwapMiddleLong    = true
bool vwapMiddleShort   = true
bool vwapMiddleHlLong  = true
bool vwapMiddleHlShort = true

if effUseVwapFilter
    if effVwapTrendType == "Follow Trend"
        vwapLongOk  := close > vwapValue
        vwapShortOk := close < vwapValue
    else if effVwapTrendType == "Counter Trend"
        vwapLongOk  := close < vwapValue
        vwapShortOk := close > vwapValue

    if effMustInMiddle == "In Middle"
        vwapMiddleLong    := (close >= vwapLower1) and (close <= vwapUpper1)
        vwapMiddleShort   := (close >= vwapLower1) and (close <= vwapUpper1)
        vwapMiddleHlLong  := (high >= vwapLower1) and (high <= vwapUpper1)
        vwapMiddleHlShort := (low >= vwapLower1) and (low <= vwapUpper1)
    else if effMustInMiddle == "Out Middle"
        vwapMiddleLong    := (close > vwapUpper1) or (close < vwapLower1)
        vwapMiddleShort   := (close > vwapUpper1) or (close < vwapLower1)
        vwapMiddleHlLong  := (high > vwapUpper1) or (high < vwapLower1)
        vwapMiddleHlShort := (low > vwapUpper1) or (low < vwapLower1)

// --- Đánh giá bộ lọc Candle Spread ---
float c_spread     = high - low
float sp_th_low    = ta.percentile_nearest_rank(c_spread, effSpreadLookback, 20.0)
float sp_th_mid    = ta.percentile_nearest_rank(c_spread, effSpreadLookback, 50.0)
float sp_th_high   = ta.percentile_nearest_rank(c_spread, effSpreadLookback, 80.0)

bool isSpreadExtremeHigh = c_spread >= sp_th_high
bool isSpreadAboveMedian = (c_spread >= sp_th_mid) and not isSpreadExtremeHigh
bool isSpreadNormalRange = (c_spread >= sp_th_low) and (c_spread < sp_th_mid)
bool isSpreadExtremeLow  = c_spread <= sp_th_low

bool spreadPass = true
if effSpreadFilterType == "Spread Bùng nổ >= 80%"
    spreadPass := isSpreadExtremeHigh
else if effSpreadFilterType == "Spread Mở rộng 50-80%"
    spreadPass := isSpreadAboveMedian
else if effSpreadFilterType == "Spread Bình thường 20-50%"
    spreadPass := isSpreadNormalRange
else if effSpreadFilterType == "Spread nén <= 20%"
    spreadPass := isSpreadExtremeLow

// 1. Điều kiện vào lệnh thông thường (Market On Close)
bool longCondition  = (effEntryType != "Breakout") and allowLong and longSignal and stLongOk and vwapLongOk and vwapMiddleLong and spreadPass and (not effFilterSideway or not isSidewayRaw) and (strategy.position_size == 0) and wfaTradeAllowed
bool shortCondition = (effEntryType != "Breakout") and allowShort and shortSignal and stShortOk and vwapShortOk and vwapMiddleShort and spreadPass and (not effFilterSideway or not isSidewayRaw) and (strategy.position_size == 0) and wfaTradeAllowed

if longCondition
    hasPendingSidewayUp := false
    lastSidewayEndBarUp := na
    hasPendingVmaLong   := false

if shortCondition
    hasPendingSidewayDown := false
    lastSidewayEndBarDown := na
    hasPendingVmaShort    := false

// 2. Đặt lệnh chờ Stop cho chế độ Breakout (Buy Stop trên High nến trước 1 tick / Sell Stop dưới Low nến trước 1 tick)
if effEntryType == "Breakout" and strategy.position_size == 0 and wfaTradeAllowed
    bool setupBreakHLLong  = allowLong and stLongOk and vwapLongOk and vwapMiddleHlLong and spreadPass and (not effFilterSideway or not isSidewayRaw)
    bool setupBreakHLShort = allowShort and stShortOk and vwapShortOk and vwapMiddleHlShort and spreadPass and (not effFilterSideway or not isSidewayRaw)
    
    if setupBreakHLLong
        strategy.entry("Long", strategy.long, stop = high + syminfo.mintick, comment = "Long (Breakout)")
    else
        strategy.cancel("Long")
        
    if setupBreakHLShort
        strategy.entry("Short", strategy.short, stop = low - syminfo.mintick, comment = "Short (Breakout)")
    else
        strategy.cancel("Short")
else if effEntryType == "Breakout" and strategy.position_size == 0 and not wfaTradeAllowed
    strategy.cancel("Long")
    strategy.cancel("Short")

// --- XỬ LÝ LỆNH LONG MỚI (MARKET ORDER CHO ST FLIP / BREAK SIDEWAY / FIRST PULLBACK / PULLBACK + SIDEWAY) ---
if longCondition
    entryPrice := close
    
    // Tính Stop Loss theo effSlType
    float baseSl = supertrendVal
    if effSlType == "Sideway Zone"
        bool isPbLongEntry = (effEntryType == "First Pullback") or (effEntryType == "Pullback + Sideway" and isFirstPbLong)
        float swLow = (isPbLongEntry and not na(pbLowUp)) ? pbLowUp : (not na(currentSwLowUp) ? currentSwLowUp : (not na(lastSidewayLow) ? lastSidewayLow : (effSidewayMethod == "Narrow Sideway" and not na(narrowLowUp) ? narrowLowUp : (effSidewayMethod == "VCP" and not na(vcpLow) ? vcpLow : (effEntryType == "VMA Reversal" and not na(vmaLongSignalLow) ? vmaLongSignalLow : supertrendVal)))))
        baseSl := swLow
    else if effSlType == "Entry Candle"
        baseSl := low
    else if effSlType == "Previous Candle"
        baseSl := low[1]
    else
        baseSl := supertrendVal
        
    // Đảm bảo mức SL hợp lệ dưới giá vào lệnh Long
    float risk = entryPrice - baseSl
    if risk <= 0.0 or risk < (baseAtr * 0.1)
        risk   := baseAtr * 1.5
        baseSl := entryPrice - risk
        
    slPrice      := baseSl
    initialRisk  := risk
    float curAtr = globalAtr
    float tpUnit = effTpType == "ATR" ? curAtr : (effTpType == "ATR (HTF)" ? nz(atrHtf, curAtr) : (effTpType == "Spread" ? syminfo.mintick : risk))
    tp1Price     := effTpType == "VWAP" ? (vwapValue + effRrrTp1 * vwapStdev) : (entryPrice + effRrrTp1 * tpUnit)
    tp2Price     := effTpType == "VWAP" ? (vwapValue + effRrrTp2 * vwapStdev) : (entryPrice + effRrrTp2 * tpUnit)
    activeDir    := 1
    entryBarIdx  := bar_index
    rrr1Reached  := false
    tp1Reached   := false
    tp2Reached   := false
    slReached    := false
    
    countTotalTrades += 1
    string entryComment = effEntryType == "Supertrend Flip" ? "Long (ST Flip)" : (effEntryType == "Break Sideway" ? "Long (Break Sideway)" : (effEntryType == "First Pullback" ? "Long (First Pullback)" : (effEntryType == "Pullback + Sideway" ? (isFirstPbLong ? "Long (First PB)" : "Long (Break SW)") : (effEntryType == "Breakout" ? "Long (Breakout)" : (effEntryType == "Breakdown" ? "Long (Breakdown)" : "Long (VMA Reversal)")))))
    strategy.entry("Long", strategy.long, comment = entryComment)

// --- XỬ LÝ LỆNH SHORT MỚI (MARKET ORDER CHO ST FLIP / BREAK SIDEWAY / FIRST PULLBACK / PULLBACK + SIDEWAY) ---
if shortCondition
    entryPrice := close
    
    // Tính Stop Loss theo effSlType
    float baseSl = supertrendVal
    if effSlType == "Sideway Zone"
        bool isPbShortEntry = (effEntryType == "First Pullback") or (effEntryType == "Pullback + Sideway" and isFirstPbShort)
        float swHigh = (isPbShortEntry and not na(pbHighDown)) ? pbHighDown : (not na(currentSwHighDown) ? currentSwHighDown : (not na(lastSidewayHigh) ? lastSidewayHigh : (effSidewayMethod == "Narrow Sideway" and not na(narrowHighDown) ? narrowHighDown : (effSidewayMethod == "VCP" and not na(vcpHighDown) ? vcpHighDown : (effEntryType == "VMA Reversal" and not na(vmaShortSignalHigh) ? vmaShortSignalHigh : supertrendVal)))))
        baseSl := swHigh
    else if effSlType == "Entry Candle"
        baseSl := high
    else if effSlType == "Previous Candle"
        baseSl := high[1]
    else
        baseSl := supertrendVal
        
    // Đảm bảo mức SL hợp lệ trên giá vào lệnh Short
    float risk = baseSl - entryPrice
    if risk <= 0.0 or risk < (baseAtr * 0.1)
        risk   := baseAtr * 1.5
        baseSl := entryPrice + risk
        
    slPrice      := baseSl
    initialRisk  := risk
    float curAtrS = globalAtr
    float tpUnitS = effTpType == "ATR" ? curAtrS : (effTpType == "ATR (HTF)" ? nz(atrHtf, curAtrS) : (effTpType == "Spread" ? syminfo.mintick : risk))
    tp1Price     := effTpType == "VWAP" ? (vwapValue - effRrrTp1 * vwapStdev) : (entryPrice - effRrrTp1 * tpUnitS)
    tp2Price     := effTpType == "VWAP" ? (vwapValue - effRrrTp2 * vwapStdev) : (entryPrice - effRrrTp2 * tpUnitS)
    activeDir    := -1
    entryBarIdx  := bar_index
    rrr1Reached  := false
    tp1Reached   := false
    tp2Reached   := false
    slReached    := false
    
    countTotalTrades += 1
    string entryComment = effEntryType == "Supertrend Flip" ? "Short (ST Flip)" : (effEntryType == "Break Sideway" ? "Short (Break Sideway)" : (effEntryType == "First Pullback" ? "Short (First Pullback)" : (effEntryType == "Pullback + Sideway" ? (isFirstPbShort ? "Short (First PB)" : "Short (Break SW)") : (effEntryType == "Breakout" ? "Short (Breakout)" : (effEntryType == "Breakdown" ? "Short (Breakdown)" : "Short (VMA Reversal)")))))
    strategy.entry("Short", strategy.short, comment = entryComment)

// --- XỬ LÝ KHỞI TẠO THÔNG SỐ KHI LỆNH BREAKout KHỚP LỆNH CHỜ (BUY STOP / SELL STOP) ---
bool isJustEnteredLong  = (strategy.position_size > 0 and nz(strategy.position_size[1], 0) <= 0)
bool isJustEnteredShort = (strategy.position_size < 0 and nz(strategy.position_size[1], 0) >= 0)

if effEntryType == "Breakout" and isJustEnteredLong
    entryPrice := strategy.position_avg_price
    
    // Tính Stop Loss theo effSlType
    float baseSl = supertrendVal
    if effSlType == "Sideway Zone"
        float swLow = not na(currentSwLowUp) ? currentSwLowUp : (not na(lastSidewayLow) ? lastSidewayLow : (effSidewayMethod == "Narrow Sideway" and not na(narrowLowUp) ? narrowLowUp : (effSidewayMethod == "VCP" and not na(vcpLow) ? vcpLow : supertrendVal)))
        baseSl := swLow
    else if effSlType == "Entry Candle"
        baseSl := low
    else if effSlType == "Previous Candle"
        baseSl := low[1]
    else
        baseSl := supertrendVal
        
    float risk = entryPrice - baseSl
    if risk <= 0.0 or risk < (baseAtr * 0.1)
        risk   := baseAtr * 1.5
        baseSl := entryPrice - risk
        
    slPrice      := baseSl
    initialRisk  := risk
    float curAtr = globalAtr
    float tpUnit = effTpType == "ATR" ? curAtr : (effTpType == "ATR (HTF)" ? nz(atrHtf, curAtr) : (effTpType == "Spread" ? syminfo.mintick : risk))
    tp1Price     := effTpType == "VWAP" ? (vwapValue + effRrrTp1 * vwapStdev) : (entryPrice + effRrrTp1 * tpUnit)
    tp2Price     := effTpType == "VWAP" ? (vwapValue + effRrrTp2 * vwapStdev) : (entryPrice + effRrrTp2 * tpUnit)
    activeDir    := 1
    entryBarIdx  := bar_index
    rrr1Reached  := false
    tp1Reached   := false
    tp2Reached   := false
    slReached    := false
    countTotalTrades += 1

if effEntryType == "Breakout" and isJustEnteredShort
    entryPrice := strategy.position_avg_price
    
    // Tính Stop Loss theo effSlType
    float baseSl = supertrendVal
    if effSlType == "Sideway Zone"
        float swHigh = not na(currentSwHighDown) ? currentSwHighDown : (not na(lastSidewayHigh) ? lastSidewayHigh : (effSidewayMethod == "Narrow Sideway" and not na(narrowHighDown) ? narrowHighDown : (effSidewayMethod == "VCP" and not na(vcpHighDown) ? vcpHighDown : supertrendVal)))
        baseSl := swHigh
    else if effSlType == "Entry Candle"
        baseSl := high
    else if effSlType == "Previous Candle"
        baseSl := high[1]
    else
        baseSl := supertrendVal
        
    float risk = baseSl - entryPrice
    if risk <= 0.0 or risk < (baseAtr * 0.1)
        risk   := baseAtr * 1.5
        baseSl := entryPrice + risk
        
    slPrice      := baseSl
    initialRisk  := risk
    float curAtrS = globalAtr
    float tpUnitS = effTpType == "ATR" ? curAtrS : (effTpType == "ATR (HTF)" ? nz(atrHtf, curAtrS) : (effTpType == "Spread" ? syminfo.mintick : risk))
    tp1Price     := effTpType == "VWAP" ? (vwapValue - effRrrTp1 * vwapStdev) : (entryPrice - effRrrTp1 * tpUnitS)
    tp2Price     := effTpType == "VWAP" ? (vwapValue - effRrrTp2 * vwapStdev) : (entryPrice - effRrrTp2 * tpUnitS)
    activeDir    := -1
    entryBarIdx  := bar_index
    rrr1Reached  := false
    tp1Reached   := false
    tp2Reached   := false
    slReached    := false
    countTotalTrades += 1

// --- QUẢN LÝ THEO DÕI VỊ THẾ & THỐNG KÊ CHI TIẾT ---

// --- QUẢN LÝ THEO DÕI VỊ THẾ & THỐNG KÊ CHI TIẾT ---

// Xác định các điều kiện Take Profit theo Price Action (Breakout2, Breakout3, FVG)
bool isMin3BarsAfterEntry = not na(entryBarIdx) and (bar_index - entryBarIdx >= 3)
bool condBo2Long  = isMin3BarsAfterEntry and (close > math.max(high[1], high[2]))
bool condBo3Long  = isMin3BarsAfterEntry and (close > math.max(high[1], math.max(high[2], high[3])))
bool condFvgLong  = (low > high[2]) and not na(entryBarIdx) and (bar_index - 2 > entryBarIdx)

bool condBo2Short = isMin3BarsAfterEntry and (close < math.min(low[1], low[2]))
bool condBo3Short = isMin3BarsAfterEntry and (close < math.min(low[1], math.min(low[2], low[3])))
bool condFvgShort = (high < low[2]) and not na(entryBarIdx) and (bar_index - 2 > entryBarIdx)

// 1. Quản lý vị thế Long
if strategy.position_size > 0
    // Cập nhật giá TP động theo dải Upper của VWAP nếu đang chọn chế độ VWAP
    if effTpType == "VWAP"
        if effTp1Mode == "Theo RRR / Tỷ lệ"
            tp1Price := vwapValue + effRrrTp1 * vwapStdev
        if effTp2Mode == "Theo RRR / Tỷ lệ"
            tp2Price := vwapValue + effRrrTp2 * vwapStdev

    // Kiểm tra chạm mốc RRR = 1
    if not rrr1Reached and not na(entryPrice) and not na(initialRisk) and high >= (entryPrice + initialRisk)
        rrr1Reached := true
        if effMoveSlToBe == "RRR = 1"
            slPrice := math.max(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt RRR 1:1
            
    // Kiểm tra chạm TP1
    bool hitTp1ConditionLong = false
    bool isLongInProfit = not na(entryPrice) and (close > entryPrice)
    if not tp1Reached
        if effTp1Mode == "Next (n) Candle"
            hitTp1ConditionLong := not na(entryBarIdx) and (bar_index - entryBarIdx >= math.max(1, int(math.round(effRrrTp1))))
        else if effTp1Mode == "Breakout2"
            hitTp1ConditionLong := condBo2Long and isLongInProfit
        else if effTp1Mode == "Breakout3"
            hitTp1ConditionLong := condBo3Long and isLongInProfit
        else if effTp1Mode == "FVG"
            hitTp1ConditionLong := condFvgLong and isLongInProfit
        else
            hitTp1ConditionLong := high >= tp1Price

    if not tp1Reached and hitTp1ConditionLong
        tp1Reached := true
        countTP1   += 1
        if effMoveSlToBe == "TP 1"
            slPrice := math.max(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt TP1
        // Nếu dùng kiểu Price Action / Next (n) Candle, đóng % khối lượng TP1 theo giá Market
        if effTp1Mode != "Theo RRR / Tỷ lệ"
            strategy.close("Long", qty_percent = tp1QtyPct, comment = "TP1 Long (" + effTp1Mode + ")")
            
    // Kiểm tra chạm TP2
    bool hitTp2ConditionLong = false
    if not tp2Reached
        if effTp2Mode == "Next (n) Candle"
            hitTp2ConditionLong := not na(entryBarIdx) and (bar_index - entryBarIdx >= math.max(1, int(math.round(effRrrTp2))))
        else if effTp2Mode == "Breakout2"
            hitTp2ConditionLong := condBo2Long and isLongInProfit
        else if effTp2Mode == "Breakout3"
            hitTp2ConditionLong := condBo3Long and isLongInProfit
        else if effTp2Mode == "FVG"
            hitTp2ConditionLong := condFvgLong and isLongInProfit
        else
            hitTp2ConditionLong := high >= tp2Price

    if not tp2Reached and hitTp2ConditionLong
        tp2Reached := true
        countTP2   += 1
        if effMoveSlToBe == "TP 2"
            slPrice := math.max(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt TP2
        // Nếu dùng kiểu Price Action / Next (n) Candle, đóng toàn bộ khối lượng còn lại của TP2
        if effTp2Mode != "Theo RRR / Tỷ lệ"
            strategy.close("Long", comment = "TP2 Long (" + effTp2Mode + ")")
        
    // Kiểm tra dính SL
    if not slReached and low <= slPrice
        slReached := true
        countSL   += 1

    // Luôn luôn duy trì lệnh Exit liên tục cho các mục chọn Theo RRR hoặc bảo vệ Stoploss
    float limTp1L = effTp1Mode == "Theo RRR / Tỷ lệ" ? tp1Price : na
    float limTp2L = effTp2Mode == "Theo RRR / Tỷ lệ" ? tp2Price : na
    strategy.exit("TP1_L", from_entry = "Long", qty_percent = tp1QtyPct, limit = limTp1L, stop = slPrice, comment_profit = "TP1 Long", comment_loss = "SL Long")
    strategy.exit("TP2_L", from_entry = "Long", limit = limTp2L, stop = slPrice, comment_profit = "TP2 Long", comment_loss = "SL Long")
    
    // Đóng vị thế còn lại theo tùy chọn effClosePosMode
    bool shouldCloseLong = false
    string closeCommentL = ""
    if effClosePosMode == "Breakdown2" and (close < math.min(low[1], low[2]))
        shouldCloseLong := true
        closeCommentL   := "Đóng Long (Breakdown2)"
    else if effClosePosMode == "Breakdown3" and (close < math.min(low[1], math.min(low[2], low[3])))
        shouldCloseLong := true
        closeCommentL   := "Đóng Long (Breakdown3)"
    else if effClosePosMode == "Supertrend đảo ngược chiều" and isSupertrendSell
        shouldCloseLong := true
        closeCommentL   := "ST Đảo chiều Giảm"
    else if effClosePosMode == "Chạm VWAP" and (low <= vwapValue)
        shouldCloseLong := true
        closeCommentL   := "Chạm VWAP"

    if shouldCloseLong
        strategy.close("Long", comment = closeCommentL)

// 2. Quản lý vị thế Short
if strategy.position_size < 0
    // Cập nhật giá TP động theo dải Lower của VWAP nếu đang chọn chế độ VWAP
    if effTpType == "VWAP"
        if effTp1Mode == "Theo RRR / Tỷ lệ"
            tp1Price := vwapValue - effRrrTp1 * vwapStdev
        if effTp2Mode == "Theo RRR / Tỷ lệ"
            tp2Price := vwapValue - effRrrTp2 * vwapStdev

    // Kiểm tra chạm mốc RRR = 1
    if not rrr1Reached and not na(entryPrice) and not na(initialRisk) and low <= (entryPrice - initialRisk)
        rrr1Reached := true
        if effMoveSlToBe == "RRR = 1"
            slPrice := math.min(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt RRR 1:1
            
    // Kiểm tra chạm TP1
    bool hitTp1ConditionShort = false
    bool isShortInProfit = not na(entryPrice) and (close < entryPrice)
    if not tp1Reached
        if effTp1Mode == "Next (n) Candle"
            hitTp1ConditionShort := not na(entryBarIdx) and (bar_index - entryBarIdx >= math.max(1, int(math.round(effRrrTp1))))
        else if effTp1Mode == "Breakout2"
            hitTp1ConditionShort := condBo2Short and isShortInProfit
        else if effTp1Mode == "Breakout3"
            hitTp1ConditionShort := condBo3Short and isShortInProfit
        else if effTp1Mode == "FVG"
            hitTp1ConditionShort := condFvgShort and isShortInProfit
        else
            hitTp1ConditionShort := low <= tp1Price

    if not tp1Reached and hitTp1ConditionShort
        tp1Reached := true
        countTP1   += 1
        if effMoveSlToBe == "TP 1"
            slPrice := math.min(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt TP1
        // Nếu dùng kiểu Price Action / Next (n) Candle, đóng % khối lượng TP1 theo giá Market
        if effTp1Mode != "Theo RRR / Tỷ lệ"
            strategy.close("Short", qty_percent = tp1QtyPct, comment = "TP1 Short (" + effTp1Mode + ")")
            
    // Kiểm tra chạm TP2
    bool hitTp2ConditionShort = false
    if not tp2Reached
        if effTp2Mode == "Next (n) Candle"
            hitTp2ConditionShort := not na(entryBarIdx) and (bar_index - entryBarIdx >= math.max(1, int(math.round(effRrrTp2))))
        else if effTp2Mode == "Breakout2"
            hitTp2ConditionShort := condBo2Short and isShortInProfit
        else if effTp2Mode == "Breakout3"
            hitTp2ConditionShort := condBo3Short and isShortInProfit
        else if effTp2Mode == "FVG"
            hitTp2ConditionShort := condFvgShort and isShortInProfit
        else
            hitTp2ConditionShort := low <= tp2Price

    if not tp2Reached and hitTp2ConditionShort
        tp2Reached := true
        countTP2   += 1
        if effMoveSlToBe == "TP 2"
            slPrice := math.min(slPrice, entryPrice) // Dời SL về Hòa vốn khi đạt TP2
        // Nếu dùng kiểu Price Action / Next (n) Candle, đóng toàn bộ khối lượng còn lại của TP2
        if effTp2Mode != "Theo RRR / Tỷ lệ"
            strategy.close("Short", comment = "TP2 Short (" + effTp2Mode + ")")
        
    // Kiểm tra dính SL
    if not slReached and high >= slPrice
        slReached := true
        countSL   += 1

    // Luôn luôn duy trì lệnh Exit liên tục cho các mục chọn Theo RRR hoặc bảo vệ Stoploss
    float limTp1S = effTp1Mode == "Theo RRR / Tỷ lệ" ? tp1Price : na
    float limTp2S = effTp2Mode == "Theo RRR / Tỷ lệ" ? tp2Price : na
    strategy.exit("TP1_S", from_entry = "Short", qty_percent = tp1QtyPct, limit = limTp1S, stop = slPrice, comment_profit = "TP1 Short", comment_loss = "SL Short")
    strategy.exit("TP2_S", from_entry = "Short", limit = limTp2S, stop = slPrice, comment_profit = "TP2 Short", comment_loss = "SL Short")
    
    // Đóng vị thế còn lại theo tùy chọn effClosePosMode
    bool shouldCloseShort = false
    string closeCommentS = ""
    if effClosePosMode == "Breakdown2" and (close > math.max(high[1], high[2]))
        shouldCloseShort := true
        closeCommentS   := "Đóng Short (Breakdown2)"
    else if effClosePosMode == "Breakdown3" and (close > math.max(high[1], math.max(high[2], high[3])))
        shouldCloseShort := true
        closeCommentS   := "Đóng Short (Breakdown3)"
    else if effClosePosMode == "Supertrend đảo ngược chiều" and isSupertrendBuy
        shouldCloseShort := true
        closeCommentS   := "ST Đảo chiều Tăng"
    else if effClosePosMode == "Chạm VWAP" and (high >= vwapValue)
        shouldCloseShort := true
        closeCommentS   := "Chạm VWAP"

    if shouldCloseShort
        strategy.close("Short", comment = closeCommentS)

// Reset cờ trạng thái khi vị thế đã đóng hoàn toàn và không có tín hiệu mới
if strategy.position_size == 0 and not (longCondition or shortCondition)
    activeDir := 0


// ==============================================================================
// 6. ĐỒ HỌA TRỰC QUAN & VẼ MỨC GIÁ (VISUALIZATION)
// ==============================================================================

// 6.1. Vẽ Hình Chữ Nhật (Box) bao quanh cụm nến Sideway
var box sidewayBox      = na
var int currentSideMode = 0 // 1: Sideway Up, -1: Sideway Down, 0: None

bool isSidewayActive = (isSidewayUp and allowLong) or (isSidewayDown and allowShort)
int activeSideMode   = (isSidewayUp and allowLong) ? 1 : ((isSidewayDown and allowShort) ? -1 : 0)

if showSidewayBox and detectSideway
    // Bắt đầu một cụm Sideway mới hoặc chuyển đổi giữa Sideway Up <-> Down hoặc vừa reset theo FVG
    if isSidewayActive and (not isSidewayActive[1] or activeSideMode != currentSideMode[1] or na(sidewayBox))
        currentSideMode := activeSideMode
        color bBorder    = color.new(#f59e0b, 20)
        color bBg        = color.new(#f59e0b, 88)
        string bText     = effSidewayMethod == "VCP" ? (activeSideMode == 1 ? "VCP Sideway Up" : "VCP Sideway Down") : (activeSideMode == 1 ? (effSidewayMethod == "Narrow Sideway" ? "Narrow Sideway Up" : "Sideway Up") : (effSidewayMethod == "Narrow Sideway" ? "Narrow Sideway Down" : "Sideway Down"))
        color tColor     = color.new(#d97706, 0)
        
        int startLeftBar = activeSideMode == 1 ? (effSidewayMethod == "VCP" and not na(vcpStartBar) ? vcpStartBar : (not na(narrowStartBarUp) ? narrowStartBarUp : bar_index)) : (effSidewayMethod == "VCP" and not na(vcpStartBarDown) ? vcpStartBarDown : (not na(narrowStartBarDown) ? narrowStartBarDown : bar_index))
        float topPrice   = activeSideMode == 1 ? (effSidewayMethod == "VCP" and not na(vcpHigh) ? vcpHigh : (not na(narrowHighUp) ? narrowHighUp : high)) : (effSidewayMethod == "VCP" and not na(vcpHighDown) ? vcpHighDown : (not na(narrowHighDown) ? narrowHighDown : high))
        float botPrice   = activeSideMode == 1 ? (effSidewayMethod == "VCP" and not na(vcpLow) ? vcpLow : (not na(narrowLowUp) ? narrowLowUp : low)) : (effSidewayMethod == "VCP" and not na(vcpLowDown) ? vcpLowDown : (not na(narrowLowDown) ? narrowLowDown : low))
        
        sidewayBox := box.new(
             left         = startLeftBar,
             top          = topPrice,
             right        = bar_index,
             bottom       = botPrice,
             border_color = bBorder,
             border_width = 1,
             border_style = line.style_solid,
             bgcolor      = bBg,
             text         = bText,
             text_size    = size.tiny,
             text_color   = tColor,
             text_valign  = text.align_top,
             text_halign  = text.align_left
        )
    // Đang trong chu kỳ Sideway: kéo dài đáy/đỉnh và mở rộng sang phải theo từng nến mới
    else if isSidewayActive and not na(sidewayBox)
        float topPrice = activeSideMode == 1 ? (effSidewayMethod == "VCP" and not na(vcpHigh) ? vcpHigh : (not na(narrowHighUp) ? narrowHighUp : high)) : (effSidewayMethod == "VCP" and not na(vcpHighDown) ? vcpHighDown : (not na(narrowHighDown) ? narrowHighDown : high))
        float botPrice = activeSideMode == 1 ? (effSidewayMethod == "VCP" and not na(vcpLow) ? vcpLow : (not na(narrowLowUp) ? narrowLowUp : low)) : (effSidewayMethod == "VCP" and not na(vcpLowDown) ? vcpLowDown : (not na(narrowLowDown) ? narrowLowDown : low))
        box.set_right(sidewayBox, bar_index)
        box.set_top(sidewayBox, topPrice)
        box.set_bottom(sidewayBox, botPrice)
    // Thoát khỏi vùng Sideway
    else if not isSidewayActive
        currentSideMode := 0
        sidewayBox      := na

// 6.2. Vẽ các đường Entry, SL, TP1, TP2 cho vị thế hiện tại (tự động kết thúc khi đóng lệnh)
bool isTradeActive = (strategy.position_size != 0) or (longCondition or shortCondition)

plot(showTradeLevels and isTradeActive ? entryPrice : na, "Mức Entry", color = color.new(#38bdf8, 0), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(showTradeLevels and isTradeActive ? slPrice : na, "Mức Stoploss (SL)", color = color.new(#ef4444, 0), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(showTradeLevels and isTradeActive and (effTp1Mode == "Theo RRR / Tỷ lệ") ? tp1Price : na, "Mức Take Profit 1 (TP1)", color = color.new(#22c55e, 0), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed)
plot(showTradeLevels and isTradeActive and (effTp2Mode == "Theo RRR / Tỷ lệ") ? tp2Price : na, "Mức Take Profit 2 (TP2)", color = color.new(#10b981, 0), linewidth = 1, style = plot.style_linebr, linestyle = plot.linestyle_dashed)

// 6.3. Vẽ Box và Tô màu nền cho Vùng Kiểm định Walk-Forward Analysis (WFA)
var box  wfaOosBox     = na
var bool prevOosActive = false

if enableWfa and wfaShowBoxes
    bool isOosStart = isOosActive and not prevOosActive
    if isOosStart
        string boxTitle = "WFA OOS #" + str.tostring(wfaCycleIndex) + " (" + wfaTf + " - " + str.tostring(wfaOosPercent) + "%)"
        wfaOosBox := box.new(
             left         = bar_index,
             top          = high,
             right        = bar_index,
             bottom       = low,
             border_color = color.new(#a855f7, 30),
             border_width = 1,
             border_style = line.style_dashed,
             bgcolor      = color.new(#a855f7, 92),
             text         = boxTitle,
             text_size    = size.tiny,
             text_color   = color.new(#c084fc, 0),
             text_valign  = text.align_bottom,
             text_halign  = text.align_right
        )
    else if isOosActive and not na(wfaOosBox)
        box.set_right(wfaOosBox, bar_index)
        box.set_top(wfaOosBox, math.max(box.get_top(wfaOosBox), high))
        box.set_bottom(wfaOosBox, math.min(box.get_bottom(wfaOosBox), low))
    else if not isOosActive
        wfaOosBox := na

prevOosActive := isOosActive

bgcolor(enableWfa and wfaShowBg and isOosActive ? color.new(#a855f7, 92) : na, title = "WFA OOS Background Highlight")


// ==============================================================================
// 7. BẢNG THỐNG KÊ DASHBOARD (STATISTICS TABLE)
// ==============================================================================

var table dashTable = na

if showTable and barstate.islast
    string posTable = tablePos == "Top Right" ? position.top_right :
                      tablePos == "Bottom Right" ? position.bottom_right :
                      tablePos == "Top Left" ? position.top_left : position.bottom_left
                      
    string szTable  = tableSize == "Tiny" ? size.tiny :
                      tableSize == "Normal" ? size.normal :
                      tableSize == "Large" ? size.large : size.small
                      
    // Khởi tạo bảng 2 cột x 15 dòng với nền màu xám nhẹ
    dashTable := table.new(posTable, 2, 15, bgcolor = color.new(#4b5563, 30), border_width = 1, border_color = color.new(#6b7280, 20), frame_color = color.new(#9ca3af, 20), frame_width = 1)
    
    // --- Header ---
    string headerRight = templateChoice != "None" ? "TEMPLATE: " + templateChoice : "GIÁ TRỊ THỐNG KÊ"
    table.cell(dashTable, 0, 0, "THÔNG SỐ HỆ THỐNG", bgcolor = color.new(#1e40af, 10), text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 0, headerRight, bgcolor = color.new(#1e40af, 10), text_color = color.white, text_size = szTable)
    
    // 1. Chế độ Supertrend & Thông số
    string modeStr = effIsAdaptive ? "Adaptive (Tự động)" : "Fixed (Cố định)"
    color  modeCol = effIsAdaptive ? color.new(#06b6d4, 0) : color.new(#9ca3af, 0)
    string trendModeStr = effStTrendType == "Follow Trend" ? "Follow" : (effStTrendType == "Counter Trend" ? "Counter" : (effStTrendType == "Swing" ? "Swing" : "Strong Trend"))
    table.cell(dashTable, 0, 1, "Chế độ Supertrend", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 1, modeStr + " (" + trendModeStr + ") [P:" + str.tostring(effectivePeriod, "#") + " | F:" + str.tostring(effectiveFactor, "#.#") + "]", text_color = modeCol, text_size = szTable)
    
    // 2. Kiểu Vào lệnh & Kiểu Stoploss
    string dispEntryType = effEntryType == "Supertrend Flip" ? "ST Flip" : (effEntryType == "Break Sideway" ? "Break Sideway" : (effEntryType == "First Pullback" ? "First Pullback" : (effEntryType == "Pullback + Sideway" ? "PB + Sideway" : (effEntryType == "Breakout" ? "Breakout" : (effEntryType == "Breakdown" ? "Breakdown" : "VMA Reversal")))))
    string dispSlType    = effSlType == "Supertrend" ? "ST" : (effSlType == "Sideway Zone" ? "Sideway" : (effSlType == "Entry Candle" ? "Entry Candle" : "Prev Candle"))
    table.cell(dashTable, 0, 2, "Kiểu Vào Lệnh / SL", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 2, dispEntryType + " | SL: " + dispSlType, text_color = color.new(#38bdf8, 0), text_size = szTable)

    // 3. Trạng thái Thị trường hiện tại (Theo biến toàn cục marketState)
    string stateStr = marketState == "Tăng mạnh" ? "Tăng mạnh 🚀" :
                      marketState == "Tăng"      ? "Tăng 📈" :
                      marketState == "Giảm mạnh" ? "Giảm mạnh 🔻" : "Giảm 📉"
    color  stateCol = marketState == "Tăng mạnh" ? color.new(#10b981, 0) :
                      marketState == "Tăng"      ? color.new(#34d399, 0) :
                      marketState == "Giảm mạnh" ? color.new(#ef4444, 0) : color.new(#f87171, 0)
    table.cell(dashTable, 0, 3, "Trạng thái Thị trường", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 3, stateStr, text_color = stateCol, text_size = szTable)
    
    // 4. Giá trị ATR & ATR HTF
    float atrCur    = globalAtr
    float atrHtfVal = nz(atrHtf, atrCur)
    table.cell(dashTable, 0, 4, "ATR (" + str.tostring(effectivePeriod, "#") + ")", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 4, str.tostring(atrCur, "#.####"), text_color = color.new(#fbbf24, 0), text_size = szTable)

    table.cell(dashTable, 0, 5, "ATR HTF (" + htfTf + ")", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 5, str.tostring(atrHtfVal, "#.####"), text_color = color.new(#a78bfa, 0), text_size = szTable)

    // 5. Vị thế hiện tại
    string posStr = strategy.position_size > 0 ? "LONG (" + str.tostring(strategy.position_size) + ")" : strategy.position_size < 0 ? "SHORT (" + str.tostring(strategy.position_size) + ")" : "FLAT (Chờ tín hiệu)"
    color  posCol = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray
    table.cell(dashTable, 0, 6, "Vị thế hiện tại", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 6, posStr, bgcolor = posCol, text_color = color.white, text_size = szTable)

    // 6. Walk-Forward Analysis (WFA)
    string wfaStatusStr = enableWfa ? (wfaTf + " | " + (isOosActive ? "Đang OOS 🔬" : "Đang IS 📚") + " (#" + str.tostring(wfaCycleIndex) + ")") : "TẮT (Full Sample)"
    color  wfaStatusCol = enableWfa ? (isOosActive ? color.new(#a855f7, 0) : color.new(#38bdf8, 0)) : color.new(#9ca3af, 0)
    table.cell(dashTable, 0, 7, "Walk-Forward (WFA)", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 7, wfaStatusStr, text_color = wfaStatusCol, text_size = szTable)
    
    // --- Tính toán thống kê chính xác từ strategy.closedtrades theo từng lượt vào lệnh (Unique Trade Entry) ---
    int calcCountTP1 = 0
    int calcCountTP2 = 0
    int calcCountSL  = 0
    int uniqueTrades = 0
    
    if strategy.closedtrades > 0
        int i = 0
        while i < strategy.closedtrades
            int   currentEntryTime = strategy.closedtrades.entry_time(i)
            bool  tradeHitTP1      = false
            bool  tradeHitTP2      = false
            bool  tradeHitSL       = false
            float tradePnlSum      = 0.0
            
            // Quét tất cả các phần thoát lệnh (slices) thuộc cùng 1 lệnh vào (cùng entry_time)
            int j = i
            while j < strategy.closedtrades and strategy.closedtrades.entry_time(j) == currentEntryTime
                string exComment = strategy.closedtrades.exit_comment(j)
                float  tradePnl   = strategy.closedtrades.profit(j)
                tradePnlSum     += tradePnl
                
                if str.contains(exComment, "TP2") and tradePnl > 0
                    tradeHitTP2 := true
                if str.contains(exComment, "TP1") and tradePnl > 0
                    tradeHitTP1 := true
                if str.contains(exComment, "SL") or tradePnl < 0
                    tradeHitSL  := true
                j += 1
                
            uniqueTrades += 1
            if tradeHitTP1
                calcCountTP1 += 1
            if tradeHitTP2
                calcCountTP2 += 1
            // Tính là lệnh dính SL nếu không chạm bất kỳ TP nào và bị đóng lệnh lỗ / SL
            if not tradeHitTP1 and not tradeHitTP2 and (tradeHitSL or tradePnlSum <= 0)
                calcCountSL += 1
                
            i := j
    else
        calcCountTP1 := countTP1
        calcCountTP2 := countTP2
        calcCountSL  := countSL
        uniqueTrades := countTotalTrades

    int dispTotalTrades = uniqueTrades > 0 ? uniqueTrades : (countTotalTrades > 0 ? countTotalTrades : 0)
    int totalTradesRef  = dispTotalTrades > 0 ? dispTotalTrades : 1
    
    float slRate  = dispTotalTrades > 0 ? (float(calcCountSL) / float(totalTradesRef)) * 100.0 : 0.0
    float tp1Rate = dispTotalTrades > 0 ? (float(calcCountTP1) / float(totalTradesRef)) * 100.0 : 0.0
    float tp2Rate = dispTotalTrades > 0 ? (float(calcCountTP2) / float(totalTradesRef)) * 100.0 : 0.0

    // 7. Tổng số lệnh đã vào
    table.cell(dashTable, 0, 8, "Tổng số lệnh đã mở", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 8, str.tostring(dispTotalTrades), text_color = color.white, text_size = szTable)
    
    // 8. Thống kê Số lần Stop Loss
    table.cell(dashTable, 0, 9, "🛑 Số lần Stoploss (SL)", text_color = color.new(#fca5a5, 0), text_size = szTable)
    table.cell(dashTable, 1, 9, str.tostring(calcCountSL) + " (" + str.tostring(slRate, "#.#") + "%)", text_color = color.new(#ef4444, 0), text_size = szTable)
    
    // 9. Thống kê Số lần chạm TP1
    string lblTp1 = effTp1Mode == "Theo RRR / Tỷ lệ" ? "🎯 Số lần Chạm TP1 (RRR)" : "🎯 Số lần Chạm TP1 (" + effTp1Mode + ")"
    table.cell(dashTable, 0, 10, lblTp1, text_color = color.new(#86efac, 0), text_size = szTable)
    table.cell(dashTable, 1, 10, str.tostring(calcCountTP1) + " (" + str.tostring(tp1Rate, "#.#") + "%)", text_color = color.new(#22c55e, 0), text_size = szTable)
    
    // 10. Thống kê Số lần chạm TP2
    string lblTp2 = effTp2Mode == "Theo RRR / Tỷ lệ" ? "🏆 Số lần Chạm TP2 (RRR)" : "🏆 Số lần Chạm TP2 (" + effTp2Mode + ")"
    table.cell(dashTable, 0, 11, lblTp2, text_color = color.new(#6ee7b7, 0), text_size = szTable)
    table.cell(dashTable, 1, 11, str.tostring(calcCountTP2) + " (" + str.tostring(tp2Rate, "#.#") + "%)", text_color = color.new(#10b981, 0), text_size = szTable)
    
    // 11. Tỷ lệ Winrate tổng thể trên sàn Backtest
    float winRate = strategy.closedtrades > 0 ? (strategy.wintrades / strategy.closedtrades) * 100.0 : 0.0
    table.cell(dashTable, 0, 12, "Tỷ lệ thắng (Win Rate)", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 12, str.tostring(winRate, "#.#") + "% (" + str.tostring(strategy.wintrades) + "/" + str.tostring(strategy.closedtrades) + ")", text_color = winRate >= 50 ? color.green : color.orange, text_size = szTable)
    
    // 12. Lợi nhuận ròng (Net Profit)
    color pnlCol = strategy.netprofit >= 0 ? color.green : color.red
    table.cell(dashTable, 0, 13, "Lợi nhuận ròng (USD)", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 13, str.tostring(strategy.netprofit, "#.##") + " USD", text_color = pnlCol, text_size = szTable)
    
    // 13. Max Drawdown
    table.cell(dashTable, 0, 14, "Sụt giảm tối đa (Max DD)", text_color = color.white, text_size = szTable)
    table.cell(dashTable, 1, 14, str.tostring(strategy.max_drawdown, "#.##") + " USD (" + str.tostring(strategy.max_drawdown_percent, "#.#") + "%)", text_color = color.new(#f87171, 0), text_size = szTable)
